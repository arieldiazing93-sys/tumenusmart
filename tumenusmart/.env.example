# Base de datos Postgres (Neon, Supabase, o la que uses)
DATABASE_URL="postgresql://usuario:password@host:5432/pedidos_app?sslmode=require"

# Contraseña vieja del panel. Desde la fase 3 sirve para UNA sola cosa: crear
# la primera cuenta de administrador. Después de eso deja de servir y se puede
# borrar la variable.
ADMIN_PASSWORD="cambiar-esta-clave"

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio).
# OBLIGATORIA en producción: sin ella el panel no deja iniciar sesión, porque
# las cookies quedarían firmadas con un valor de ejemplo que está en el código.
SESSION_SECRET="cambiar-por-un-string-random-largo"

# Supabase Storage — para subir fotos de productos desde el panel admin.
# SUPABASE_URL: la "Project URL" del proyecto (Settings → API).
# SUPABASE_SERVICE_ROLE_KEY: la "service_role" key (Settings → API) — NUNCA
# la expongas al navegador, solo se usa del lado del servidor.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cambiar-por-la-service-role-key"
