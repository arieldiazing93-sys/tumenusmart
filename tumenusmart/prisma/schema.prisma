// Esquema de base de datos — multi-local.
//
// Cada fila de negocio (Store) es un local, y TODAS las tablas de datos
// cuelgan de una a través de `storeId`. Esa columna es lo que separa a un
// negocio de otro: si una consulta se olvida de filtrarla, un local vería
// los datos de otro. Por eso no se filtra a mano en cada consulta, sino
// que se usa el acceso de src/lib/prisma-local.ts, que la inyecta solo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id             String   @id @default(cuid())
  // Nombre en la URL pública: tumenusmart.app/lafogata
  slug           String   @unique
  nombre         String
  whatsappNumero String // formato internacional sin '+', ej: 595981234567
  logoUrl        String?
  // Color de marca del local (hex, ej "#2E7D32") para el menú público — el
  // panel admin sigue siempre naranja, esto es solo lo que ve el cliente del
  // restaurante. Sin valor, el menú público usa el mismo naranja de siempre.
  colorPrimario  String?
  direccion      String?
  mensajeSaludo  String? // texto opcional al inicio del mensaje de WhatsApp (pedidos)
  mensajeSaludoReserva String? // texto opcional al inicio del mensaje de WhatsApp (reservas)
  lat            Float? // ubicación del local, centro para calcular distancias de envío
  lng            Float?
  envioModo      String   @default("zonas") // "zonas" (radio + precio automático) | "coordinar" (el negocio lo define directo con el cliente)

  // --- Formas de pago y de entrega ---
  // Qué opciones ve el cliente en el checkout público. Todas arrancan en true
  // para que los locales existentes sigan viendo las mismas 6 opciones de
  // siempre hasta que el dueño entre a Configuración y destilde alguna.
  aceptaEfectivo       Boolean @default(true)
  aceptaTransferencia  Boolean @default(true)
  aceptaTarjetaDebito  Boolean @default(true)
  aceptaTarjetaCredito Boolean @default(true)
  aceptaDelivery       Boolean @default(true)
  aceptaRetiro         Boolean @default(true)
  aceptaMesa           Boolean @default(true)

  // Si este local reserva mesas con anticipación. Es OTRA cosa que
  // "aceptaMesa" de arriba (ese es "comer en el local" al hacer un pedido
  // ahora); esto es el botón "Reservar mesa" del menú público, para locales
  // que solo hacen delivery/retiro y no tienen mesas físicas que reservar.
  aceptaReservas Boolean @default(true)

  /// Si este local vende a crédito (fiado / cuenta corriente): prendido, el
  /// Punto de Venta ofrece "A crédito" como forma de pago y aparece Cuentas
  /// por cobrar. Apagado (default), todo sigue como siempre.
  ventasACredito Boolean @default(false)

  /// Cómo se ve la carta pública de este local.
  ///
  /// "lista"    — filas compactas con miniatura. Es lo mejor para el local que
  ///              saca las fotos con el celular: la foto chica disimula.
  /// "tarjetas" — foto grande arriba de cada producto. Para el local que tiene
  ///              fotos profesionales, donde la foto es lo que vende.
  ///
  /// Forzar un solo diseño castiga a uno de los dos.
  estiloCarta    String   @default("lista")

  /// "sistema" | "claro" | "oscuro" — cómo se ve el menú público.
  /// "sistema" sigue el modo (claro/oscuro) del dispositivo de quien mira,
  /// vía prefers-color-scheme; "claro"/"oscuro" lo fuerzan sin importar el
  /// dispositivo. El panel admin nunca lee este campo — queda siempre claro.
  modoPlantilla  String   @default("sistema")
  // Corte manual: el encargado apaga los pedidos aunque esté dentro del
  // horario (cocina saturada, falta de personal, etc.).
  pedidosPausados Boolean @default(false)
  mensajePausa    String? // motivo opcional que ve el cliente al entrar

  // Política a nivel LOCAL (no de un punto de expedición puntual): si el
  // timbrado Autoimpresor de este negocio exige facturar TODA venta (RG
  // 90/2021 SET/DNIT), el dueño lo prende acá. Prendido: el POS deja de
  // ofrecer "Ticket" y el checkout público sigue mostrando las mismas dos
  // opciones de siempre, pero "Ticket" se guarda igual como factura a
  // Consumidor Final. Default false: comportamiento actual, sin cambios.
  facturaObligatoria Boolean @default(false)

  // --- Fidelización ---
  // Cada N pedidos ENTREGADOS del mismo cliente suman uno para un premio.
  // Sin niveles ni puntos: un umbral y un premio en texto libre.
  fidelizacionActiva Boolean @default(false)
  fidelizacionUmbral Int     @default(10)
  fidelizacionPremio String?
  // Opcional: un pedido solo suma si su total llega a este monto. Nulo =
  // sin mínimo, cualquier pedido entregado suma (comportamiento de antes).
  // Existe para que pedidos muy baratos no le "regalen" el sello al cliente.
  fidelizacionMontoMinimo Int?

  // --- Suscripción ---
  // "activo" atiende con normalidad. "prueba" es igual que activo, sirve
  // para saber que todavía no pagó nunca. "suspendido" y "vencido" apagan
  // el menú público (ver estaSuspendido) pero conservan todo — son la
  // MISMA acción por dos causas distintas: "suspendido" lo apagaste vos a
  // mano (alternarSuspension); "vencido" lo apagó solo el cron diario por
  // falta de pago (suspender-vencidos). Separados para que el panel de
  // cartera pueda avisarte de uno y no del otro — antes compartían el mismo
  // valor y un cliente vencido se veía igual que uno que vos apagaste.
  estado         String    @default("activo")
  // Hasta cuándo está pago (inclusive). Null = todavía no se activó: el local
  // atiende con normalidad pero su plazo no corre. Un local nuevo nace así y
  // la fecha se la pone "Activar" en Cartera (un mes desde ese día) o su
  // primer pago registrado.
  vencimiento    DateTime?
  plan           String    @default("basico")

  /// Rubro del negocio, para la cartera de TuMenuSmart (clave de
  /// src/lib/tipo-negocio.ts: "comidas_rapidas", "barberia_peluqueria",
  /// "salon_belleza", "taller", "heladeria", "bodega", "veterinaria"). Nulo en
  /// los locales creados antes de que existiera el campo: se completa desde
  /// Cartera ("Ver" → "Editar"). No lo ve el propio local.
  tipoNegocio    String?

  // Quién de tu equipo comercial trajo o atiende este cliente. Se asigna al
  // dar de alta el local (o después, a mano) — nunca lo elige ni lo ve el
  // dueño del local, es solo para tu propia cartera.
  asesorId       String?
  asesor         Asesor?   @relation(fields: [asesorId], references: [id])

  // --- Datos del titular ---
  // Para uso interno de TuMenuSmart (facturación, contacto directo con el
  // dueño real) — no lo ve el cliente ni el propio local en su panel. Los
  // cuatro son opcionales: se cargan si se tienen a mano al dar de alta, o
  // se completan/editan después desde Cartera.
  titularNombre   String?
  titularTelefono String?
  razonSocial     String?
  ruc             String?

  // --- Numeración propia de cada local ---
  // Así cada negocio ve sus pedidos desde el #0001 en vez de heredar un
  // contador global compartido con el resto. Se incrementan de a uno en
  // la misma transacción que crea el pedido o la reserva.
  contadorPedidos  Int @default(0)
  contadorReservas Int @default(0)
  contadorVentasPos Int @default(0)
  // Igual que los anteriores, para la Clave de Customer.numero.
  contadorClientes Int @default(0)
  // Y para el N° de cada presupuesto/cotización (Cotizacion.numero).
  contadorCotizaciones Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categorias     Category[]
  productos      Product[]
  opciones       ProductOption[]
  zonas          DeliveryZone[]
  clientes       Customer[]
  repartidores   Repartidor[]
  pedidos        Order[]
  itemsPedido    OrderItem[]
  reservas       Reservation[]
  horariosReserva  HorarioReserva[]
  horariosAtencion HorarioAtencion[]
  horariosCategoria CategoriaHorario[]
  usuarios         Usuario[]
  ideasSemanales   IdeaSemanal[]
  pagos            Pago[]
  urlsAnteriores   SlugAnterior[]
  rendiciones      Rendicion[]
  turnosPos        TurnoPos[]
  ventasPos        VentaPos[]
  movimientosCaja  MovimientoCaja[]
  cobrosVenta      CobroVenta[]
  pagosVenta       PagoVenta[]
  bitacoras        Bitacora[]
  ventaPosItems    VentaPosItem[]
  estaciones       Estacion[]
  puntosExpedicion PuntoExpedicion[]
  areasImpresion   AreaImpresion[]
  estacionesImpresoras EstacionImpresora[]
  facturasReemplazadas FacturaReemplazada[]
  comprobantes         Comprobante[]
  comprobanteItems     ComprobanteItem[]
  emisorFiscal         EmisorFiscal?
  optionGroups         OptionGroup[]
  optionGroupProductos OptionGroupProduct[]
  productOptionGroups  ProductOptionGroup[]

  // --- Control de stock ---
  categoriasInsumo CategoriaInsumo[]
  insumos          Insumo[]
  recetaItems      RecetaItem[]
  ingredientesElaborados IngredienteElaborado[]
  proveedores      Proveedor[]
  almacenes        Almacen[]
  cotizaciones     Cotizacion[]
  cotizacionItems  CotizacionItem[]
  compras          Compra[]
  pagosCompra      PagoCompra[]
  compraItems      CompraItem[]
  gastos           Gasto[]
  movimientosStock MovimientoStock[]
  inventarios      Inventario[]
  inventarioItems  InventarioItem[]
  categoriasGasto  CategoriaGasto[]

  // --- Reserva de turnos ---
  miembrosPersonal MiembroPersonal[]
  citas            Cita[]
  horariosTrabajo  HorarioTrabajo[]
  serviciosAgenda  ServicioAgenda[]
  serviciosPersonal ServicioPersonal[]
  paginaReservas   PaginaReservas?
  citaServicios    CitaServicio[]
}

/// Las direcciones que este local tuvo antes.
///
/// Cuando un negocio cambia su URL, los carteles con QR ya impresos, los
/// enlaces compartidos por WhatsApp y lo que Google tenga indexado siguen
/// apuntando a la vieja. Sin esto, todo eso muere el día del cambio.
///
/// Guardando la anterior, la carta redirige sola a la nueva y nadie se entera.
model SlugAnterior {
  id      String   @id @default(cuid())
  slug    String   @unique
  storeId String
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creadoEn DateTime @default(now())

  @@index([storeId])
}

/// Cada problema técnico que ocurrió en producción.
///
/// No es un registro de todo: los errores se AGRUPAN por su huella, así que
/// una fila es "un problema", no "una vez que falló". Si el mismo bug ocurre
/// doscientas veces, es una fila con ocurrencias = 200.
///
/// Esa distinción es la que hace que la pantalla sea legible: una lista de
/// doscientas líneas iguales no se mira, una de tres problemas sí.
model ErrorReportado {
  id String @id @default(cuid())

  /// Qué problema es. Sale de huellaDeError(): mismo bug con ids distintos
  /// cae en la misma huella.
  huella String @unique

  /// De qué local. Nulo cuando el error ocurrió fuera del contexto de uno
  /// (la portada, el login, un cron).
  storeId     String?
  nombreLocal String?

  ruta    String
  mensaje String
  /// El rastro completo, recortado. Es lo que se lee para entender la causa.
  detalle String?
  /// Qué usuario lo sufrió, si había sesión.
  usuario String?

  ocurrencias Int      @default(1)
  primeraVez  DateTime @default(now())
  ultimaVez   DateTime @default(now())

  /// Cuándo se mandó el último correo por este problema. Nulo = nunca se avisó.
  avisadoEn DateTime?
  /// Marcado como resuelto a mano desde el panel. No se borra: si vuelve a
  /// ocurrir se desmarca solo y vuelve a avisar.
  resuelto Boolean @default(false)

  @@index([resuelto, ultimaVez])
  @@index([storeId])
}

/// Cada pago recibido de un local.
///
/// Se guarda el historial completo y no solo el vencimiento vigente: cuando un
/// cliente pregunta "yo te pagué en mayo", la respuesta tiene que estar en el
/// sistema y no en la memoria de nadie.
model Pago {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// En guaraníes. Se guarda lo que efectivamente entró.
  monto  Decimal  @db.Decimal(12, 2)
  /// Cuándo se recibió el pago.
  fecha  DateTime @default(now())
  /// Hasta qué día queda cubierto el local con este pago.
  cubreHasta DateTime
  /// Cuántos meses se cobraron, para poder reconstruir el criterio.
  meses  Int      @default(1)
  /// Número de transferencia, o cualquier cosa que sirva para encontrarlo.
  nota   String?

  /// Quién lo registró. Se guarda el correo y no el id: si algún día se borra
  /// ese usuario, el historial de cobranza igual sigue diciendo quién fue.
  registradoPor String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeId, fecha])
}

/// Un vendedor/asesor comercial de TuMenuSmart (no de un local puntual —
/// esto es tuyo, de la plataforma). No cuelga de ningún Store por storeId
/// como el resto de las tablas: es al revés, son los Store los que apuntan
/// acá para decir quién los trajo.
model Asesor {
  id       String  @id @default(cuid())
  nombre   String
  telefono String
  ciudad   String
  email    String

  /// Un asesor que ya no trabaja más no se borra (perdería la referencia en
  /// los locales que trajo) — se lo marca inactivo y desaparece de la lista
  /// para asignar en locales nuevos, sin tocar los que ya tiene.
  activo Boolean @default(true)

  createdAt DateTime @default(now())

  locales Store[]
}

/// La idea que se le pone adelante al dueño cada semana.
///
/// La pantalla de Ideas calcula todo en vivo cada vez que se abre, pero eso
/// sirve para hurgar, no para actuar. Una vez por semana se elige UNA sola y
/// se guarda acá, por tres motivos: que no cambie de un rato a otro dentro de
/// la misma semana, poder saber si el dueño ya la vio, y no repetirle lo
/// mismo varios lunes seguidos.
model IdeaSemanal {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Lunes de la semana, en formato AAAA-MM-DD y en hora de Asunción.
  /// Es texto y no fecha a propósito: identifica la semana sin que el huso
  /// horario pueda correrla un día para atrás o para adelante.
  semana String

  /// Cuál de los análisis quedó elegido, para no repetirlo la semana próxima.
  clave     String
  tipo      String
  titulo    String
  dato      String
  accion    String
  confianza String
  /// Filas de apoyo, guardadas como JSON en texto.
  detalle   String?

  /// Cuándo la vio el dueño. Mientras esté vacío, el panel muestra el aviso.
  vistaEn   DateTime?
  createdAt DateTime  @default(now())

  @@unique([storeId, semana])
  @@index([storeId])
}

/// Quién puede entrar al panel.
///
/// OJO: este modelo NO entra en el filtro automático por local, y es a
/// propósito. El ingreso ocurre antes de saber de qué local se trata —
/// justamente lo averiguamos leyendo esta tabla— así que filtrarlo por
/// local haría imposible iniciar sesión. Cada consulta de acá decide
/// explícitamente su alcance.
model Usuario {
  id           String  @id @default(cuid())
  email        String  @unique
  // Formato "scrypt:sal:hash". Nunca se guarda la contraseña en claro.
  passwordHash String
  nombre       String?

  /// "superadmin" ve todos los locales y administra usuarios.
  /// "local" queda atado a su negocio y no sabe que existen otros.
  /// Es texto y no enum para poder sumar "empleado" sin migrar la base.
  rol     String  @default("local")
  /// Nulo solamente para el superadmin, que no pertenece a ningún local.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  activo Boolean @default(true)

  /// Queda en true cuando la contraseña la generó el sistema o la restableció
  /// un administrador. Mientras esté así, el panel le insiste al usuario que
  /// la cambie: una contraseña que pasó por WhatsApp la vio más de una persona.
  debeCambiarPassword Boolean @default(false)

  // --- Freno a la fuerza bruta ---
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  ultimoIngreso    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// Horario de atención del local, un registro por tramo. Un día SIN
// registros = cerrado ese día (ej: cierra los lunes). Dos registros el
// mismo día = turno partido (ej: 11:00-14:00 y 18:00-23:30).
model HorarioAtencion {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  diaSemana Int // 0 = domingo, 1 = lunes ... 6 = sábado
  abre      String // "HH:MM"
  cierra    String // "HH:MM" — si es menor que `abre`, el cierre cae pasada la medianoche
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int       @default(0)
  // Si está en false, la categoría (y sus productos) no aparecen en el
  // menú público, pero se conservan en el admin — útil para promos de un
  // día sin tener que borrar nada.
  activa    Boolean   @default(true)
  /// true = es una categoría de servicios de la Reserva de turnos (Cortes,
  /// Barba, Color…). Sus servicios son Products con esServicio = true, así que
  /// se venden en el punto de venta y se facturan como cualquier producto.
  paraServicios Boolean @default(false)
  productos Product[]
  createdAt DateTime  @default(now())
  // Días y horarios en que esta categoría se OCULTA de la carta pública —
  // ej: "Hamburguesas Simple" no se vende lunes ni martes. Es al revés del
  // horario de atención del local: sin tramos cargados, la categoría se
  // muestra SIEMPRE (default), y los tramos cargados son ventanas de
  // bloqueo puntuales, no un horario completo que haya que definir.
  horarios  CategoriaHorario[]

  @@index([storeId])
}

// Mismo shape que HorarioAtencion (día + abre + cierra), pero el criterio es
// el opuesto: acá el tramo dice cuándo se OCULTA la categoría, no cuándo
// atiende el local. Reutiliza el cálculo de "¿estamos dentro de alguno de
// estos tramos ahora?" (`calcularEstadoAtencion`, genérica) a través de
// `categoriaOcultaPorHorario` en horario-atencion.ts, que es la que invierte
// el resultado. Dos categorías pueden tener bloqueos muy distintos entre sí
// (ej: "Hamburguesas Simple" lunes y martes, "Postres" ninguno).
model CategoriaHorario {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  diaSemana  Int // 0=domingo … 6=sábado, mismo criterio que HorarioAtencion
  abre       String // "HH:MM"
  cierra     String // "HH:MM"

  @@index([storeId])
  @@index([categoryId])
}

model Product {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  // A qué Área de Impresión (Cocina, Barra, Caja...) se manda este producto
  // en la comanda automática — ver AreaImpresion. Null = no imprime en
  // ninguna comanda automática (comportamiento esperado, no un error; el
  // producto se sigue viendo en la comanda completa manual).
  areaImpresionId String?
  areaImpresion   AreaImpresion? @relation(fields: [areaImpresionId], references: [id], onDelete: SetNull)
  // De qué almacén descuenta la receta de este producto cuando se vende
  // (Control de stock). Null = el almacén principal (el más antiguo activo)
  // — ver src/lib/movimientos-stock.ts.
  almacenId   String?
  almacen     Almacen?        @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  nombre      String
  descripcion String?
  precio      Decimal         @db.Decimal(10, 2)
  /// Costo cargado a mano (ya no se edita en el formulario de Productos). Si
  /// el producto tiene receta, su costo sale de ahí — ver
  /// src/lib/costo-receta.ts —; este valor solo se usa cuando no hay receta.
  /// Si ninguno de los dos existe, el analista comercial habla de
  /// facturación pero no de margen, en vez de inventarlo.
  costo       Decimal?        @db.Decimal(10, 2)
  // "gravado10" | "gravado5" | "exento" — string simple con whitelist en la
  // Server Action, no enum de Prisma (mismo criterio que mitadYMitadModo).
  // Todavía no lo consume ningún cálculo: es la base para el desglose de
  // IVA de la futura Factura Autoimpresor.
  iva         String          @default("gravado10")
  // "unidad" | "kilogramo" | "litro" — ver src/lib/unidad-medida.ts, con el
  // código oficial de la Tabla 5 de SIFEN para cada valor. Mismo criterio
  // que iva: todavía no lo consume ningún cálculo acá, pero es un dato que
  // va a pedir la futura API de factura electrónica por cada ítem.
  unidadMedida String         @default("unidad")
  /// true = es un servicio (un corte de pelo, una revisión, una consulta), no
  /// una mercadería. La factura electrónica distingue "venta de mercadería" de
  /// "prestación de servicios" (iTipTra de SIFEN); con esto el comprobante
  /// arma solo el tipo de transacción correcto. En la factura autoimpresor no
  /// cambia nada.
  esServicio   Boolean        @default(false)
  imagenUrl   String?
  disponible  Boolean         @default(true)
  orden       Int             @default(0)
  // Ingredientes "de base" del producto, mostrados como etiquetas que el
  // cliente puede sacar (no agregar) al pedir — ej: ["tomate", "cebolla"].
  ingredientes String[]       @default([])
  // "Mitad y mitad": si tiene un grupo cargado, este producto se puede
  // combinar con cualquier otro producto que tenga EXACTAMENTE el mismo
  // texto de grupo (ej: "Pizza Grande") — así conviven en el mismo menú
  // productos de distinto tamaño sin mezclarse entre sí. Vacío = no aplica.
  mitadYMitadGrupo String?
  // "mayor": cobra el precio del más caro de los dos. "proporcional": la
  // mitad de cada uno, sumadas. Debería ser el mismo valor en todos los
  // productos de un mismo grupo.
  mitadYMitadModo  String          @default("mayor")
  // Si está marcado, aparece en el carrusel de destacados del menú público.
  destacado   Boolean         @default(false)
  opciones    ProductOption[]
  gruposAgregados ProductOptionGroup[]
  // Grupos donde ESTE producto se usa como modificador de otro (ej: "Salsa
  // BBQ" referenciada dentro del grupo "Salsas") — ver OptionGroupProduct.
  usadoComoModificador OptionGroupProduct[]
  // Qué insumos descuenta este producto al venderse, y cuánto de cada uno
  // — ver RecetaItem (Control de stock). Vacío = no descuenta nada, ni
  // bloquea nada: la receta es opcional, se arma solo si el negocio
  // controla stock. Un "extra"/agregado de grupo (ver
  // usadoComoModificador) también es un Product, así que su propia receta
  // funciona igual, sin ningún caso especial.
  receta      RecetaItem[]
  /// Si es un servicio de la Reserva de turnos: su duración, búfer, color y
  /// quién lo realiza (ver ServicioAgenda).
  servicioAgenda ServicioAgenda?
  orderItems  OrderItem[]
  ventaPosItems VentaPosItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([almacenId])
}

// Cubre tanto variantes (tamaño, sabor — normalmente eliges una)
// como agregados (extras — normalmente eliges varios).
model ProductOption {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nombre      String
  tipo        String // "variante" | "agregado"
  precioExtra Decimal @db.Decimal(10, 2) @default(0)
  /// Lo que le cuesta al negocio esta variante o agregado extra (ej: la
  /// papa frita que se agrega a una hamburguesa). Opcional, mismo criterio
  /// que Product.costo: mientras esté vacío, el reporte de rentabilidad no
  /// puede calcular el margen real de lo que se vendió CON este agregado —
  /// antes esa plata quedaba contada como ganancia del producto principal,
  /// inflando su margen cada vez que se vendía con algo pago encima.
  costo       Decimal? @db.Decimal(10, 2)
  // Mismo criterio que Product.iva/unidadMedida (ver ahí): un agregado
  // (ej: "Extra queso") pasa a ser su propia línea al facturar, y la futura
  // API de factura electrónica va a necesitar su propia tasa y unidad, no
  // asumir la del producto al que se cuelga.
  iva          String  @default("gravado10")
  unidadMedida String  @default("unidad")
  orden       Int     @default(0)

  @@index([storeId])
  @@index([productId])
}

// Un grupo con nombre (ej. "Salsas", "Quesos") reutilizable en varios
// productos a la vez — a diferencia de ProductOption (agregado propio de
// UN producto), acá se adjunta el MISMO grupo a varios productos vía
// ProductOptionGroup, así que corregir un modificador del grupo lo corrige
// en todos los productos que lo usan, sin tener que recargarlo a mano en
// cada uno.
model OptionGroup {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  modificadores OptionGroupProduct[]
  productos     ProductOptionGroup[]

  @@index([storeId])
}

// Un modificador dentro de un grupo NO es una entidad con datos propios —
// es un Product real (ej. "Salsa BBQ", cargado normalmente en
// /admin/productos, con su propia categoría, precio, IVA y unidad de
// medida) referenciado acá. Mismo patrón que SoftRestaurant (confirmado
// por capturas del dueño): un "producto compuesto" arma sus modificadores
// eligiendo productos ya existentes del catálogo, no tipeando de nuevo un
// nombre/precio aparte. Editar el producto en su propia pantalla alcanza
// para que el cambio se vea en todos los grupos donde se lo usa.
model OptionGroupProduct {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  groupId   String
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orden     Int         @default(0)

  @@unique([groupId, productId])
  @@index([storeId])
  @@index([groupId])
  @@index([productId])
}

// Join M:N — qué grupos están adjuntados a qué producto. Mismo patrón que
// EstacionImpresora: se adjunta con un upsert, se desadjunta con un
// deleteMany, nunca se pisa la fila de otro producto ni la de otro grupo.
model ProductOptionGroup {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String
  group     OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orden     Int         @default(0)

  @@unique([productId, groupId])
  @@index([storeId])
  @@index([productId])
  @@index([groupId])
}

// Solo se usa cuando Store.envioModo = "zonas". Cada zona es un anillo de
// distancia desde el local: "hasta radioKm kilómetros, cuesta costoEnvio".
// Se evalúan ordenadas de menor a mayor radio; la primera que alcanza la
// distancia del cliente es la que se aplica.
model DeliveryZone {
  id         String  @id @default(cuid())
  storeId    String
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre     String // etiqueta libre, ej: "Zona 1" o "Centro"
  radioKm    Decimal @db.Decimal(6, 2)
  costoEnvio Decimal @db.Decimal(10, 2)
  activo     Boolean @default(true)
  orders     Order[]

  @@index([storeId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  // Opcional: un cliente que se da de alta solo por facturar (Fase 5 de
  // Factura Autoimpresor, ver identificación fiscal más abajo) puede no
  // dar el teléfono — eso no le impide facturar, solo lo deja afuera de la
  // fidelización por teléfono.
  telefono  String?
  orders    Order[]
  createdAt DateTime @default(now())

  // Pedidos entregados de este cliente ya "gastados" en un premio anterior.
  // No se resetea el conteo de pedidos entregados: se SUMA el umbral acá
  // cada vez que se entrega un premio, para no perder los pedidos de más
  // que hizo antes de que alguien marcara el canje.
  pedidosCanjeados Int @default(0)

  // Identificación fiscal (RUC/Cédula/Pasaporte/etc. — ver
  // src/lib/tipo-cliente.ts) para la Factura Autoimpresor del POS. Se carga
  // la primera vez que el cliente factura con registro fiscal y queda para
  // las próximas visitas. Null en los clientes que solo existen por
  // fidelización y nunca facturaron.
  tipoIdentificacion   String?
  numeroIdentificacion String?

  // Clave secuencial visible del cliente — nullable y SIN backfill (mismo
  // criterio que tipoIdentificacion/numeroIdentificacion): los clientes ya
  // cargados se quedan sin clave, no amerita un script de datos. Sale de
  // Store.contadorClientes vía siguienteNumeroCliente(), y solo se asigna
  // en el momento en que el Customer se crea de verdad (nunca en un update
  // — evita gastar una clave nueva cada vez que un cliente que ya existe
  // vuelve a facturar, que es el caso más común, no el raro).
  numero Int?
  // Pensado para el día que se implemente la factura electrónica — no se
  // usa para enviar nada todavía.
  email  String?

  // El mismo número puede ser cliente de dos locales distintos: son
  // personas distintas para cada negocio. Postgres no choca dos NULL entre
  // sí, así que un cliente sin teléfono, otro sin identificación fiscal y
  // otro sin clave conviven sin problema con estos índices.
  @@unique([storeId, telefono])
  @@unique([storeId, tipoIdentificacion, numeroIdentificacion])
  @@unique([storeId, numero])
  @@index([storeId])
}

model Repartidor {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  telefono  String?
  activo    Boolean  @default(true)
  orders    Order[]
  rendiciones Rendicion[]
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Order {
  id                   String        @id @default(cuid())
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Número correlativo para mostrarle al cliente y al encargado — el id
  // (cuid) sigue siendo la clave interna/URLs, pero un código con letras y
  // números confunde al cliente al leerlo por teléfono.
  // Número que ve el cliente. Sale de `contadorPedidos` del local, así cada
  // negocio lleva su propia numeración desde el #0001.
  //
  // A propósito NO tiene valor por defecto: si alguna consulta se olvidara de
  // pedirle el número al local, no compila. Y si igual llegara a la base, la
  // base la rechaza. Un número equivocado sería visible para el cliente.
  numero               Int
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  clienteNombre        String
  clienteTelefono      String
  estado               String        @default("pendiente") // pendiente | confirmado | en_preparacion | en_despacho | entregado | cancelado
  tipoEntrega          String // "delivery" | "retiro" | "mesa"
  deliveryZoneId       String?
  deliveryZone         DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  repartidorId         String? // solo aplica a pedidos "delivery" en camino
  repartidor           Repartidor?   @relation(fields: [repartidorId], references: [id])
  direccion            String?
  // Solo para tipoEntrega "mesa": el número/nombre que el cliente escribió
  // para identificar dónde está sentado. Null en delivery/retiro.
  mesaNumero           String?
  clienteLat           Float? // pin que marcó el cliente en el mapa al hacer el pedido
  clienteLng           Float?
  metodoPagoReferencia String // "efectivo" | "transferencia" | "tarjeta" | "otro" — solo informativo, no se procesa

  /// Lo que el repartidor DE VERDAD cobró al entregar.
  ///
  /// No es lo mismo que metodoPagoReferencia: ese es lo que el cliente dijo
  /// que iba a pagar cuando armó el pedido. En la puerta cambia todo el
  /// tiempo — dijo efectivo y sacó la tarjeta, o al revés. Para cuadrar la
  /// caja del repartidor sirve lo que pasó, no lo que se pensaba hacer.
  ///
  /// null mientras el pedido no esté entregado.
  cobroMetodo          String? // "efectivo" | "tarjeta_debito" | "tarjeta_credito" | "transferencia"
  entregadoEn          DateTime?

  /// A qué cierre de caja pertenece. null = todavía no lo rindió.
  rendicionId          String?
  rendicion            Rendicion? @relation(fields: [rendicionId], references: [id])

  /// Solo para retiro/mesa (nunca delivery, que sigue yendo por
  /// rendicionId/cobroMetodo): forma de pago declarada al marcar el pedido
  /// "entregado", y a qué turno de caja del Punto de Venta quedó atado —
  /// mismos 4 valores y mismo cierre que una venta de mostrador, sin un
  /// segundo paso de caja aparte. Null si no había un turno abierto en ese
  /// momento (el pedido queda entregado igual, simplemente no entra en
  /// ningún cierre).
  formaPagoPos         String?
  turnoPosId           String?
  turnoPos             TurnoPos?     @relation(fields: [turnoPosId], references: [id])

  comprobanteTipo      String        @default("ticket") // "ticket" | "factura"
  facturaRazonSocial   String?
  facturaRuc           String?
  // Clasificación fiscal SET del comprador (Tabla 3, RG 90/2021) — "ruc" |
  // "sin_nombre" | etc. (ver src/lib/tipo-cliente.ts). Null en pedidos de
  // antes de esta fase, donde solo se guardaba razón social/RUC a secas.
  facturaTipoIdentificacion String?
  facturaEmail         String?

  // Fiscales — se completan y se CONGELAN solo cuando se emite como
  // factura de verdad (retiro/mesa al marcar "entregado", delivery al
  // pasar a "en_despacho" — ver cambiarEstadoPedido en pedidos/actions.ts).
  // A diferencia de VentaPos (que lee el emisor en vivo vía
  // turnoPos.estacion.puntoExpedicion porque una venta de mostrador SIEMPRE
  // tiene turno), acá también se congela razonSocialEmisor/rucEmisor: un
  // pedido de delivery nunca tiene turno, así que no hay otra forma de
  // rastrear después qué punto de expedición lo emitió.
  facturaNumero            String?
  facturaTimbrado          String?
  facturaVencimiento       DateTime?
  facturaGravado10         Decimal?  @db.Decimal(10, 2)
  facturaGravado5          Decimal?  @db.Decimal(10, 2)
  facturaExento            Decimal?  @db.Decimal(10, 2)
  facturaIva10             Decimal?  @db.Decimal(10, 2)
  facturaIva5              Decimal?  @db.Decimal(10, 2)
  facturaRazonSocialEmisor String?
  facturaRucEmisor         String?

  notas                String?

  // Auditoría de cancelación — mismos campos y mismo criterio que
  // VentaPos: no se borra la fila, queda quién y por qué. A diferencia de
  // VentaPos (que tiene un booleano `cancelada` aparte), acá "cancelado" ya
  // es uno de los valores posibles de `estado`.
  canceladaPor      String?
  canceladaEn       DateTime?
  motivoCancelacion String?

  // Anular SOLO la factura, sin cancelar el pedido — independiente de
  // "cancelado" de arriba. Existe para el caso de una factura mal cargada
  // (RUC equivocado, razón social mal escrita): se anula el número, pero el
  // pedido en sí sigue siendo una venta real, entregada y cobrada. Cancelar
  // el pedido entero SIGUE anulando la factura de yapa (ver
  // cambiarEstadoPedido) — lo que cambia acá es que ahora también se puede
  // anular la factura SIN tocar el pedido. Los campos facturaNumero/
  // facturaRazonSocial/etc. de arriba NUNCA se pisan ni se limpian: quedan
  // como el registro histórico de qué decía ese número antes de anularse.
  facturaAnulada         Boolean   @default(false)
  facturaAnuladaPor      String?
  facturaAnuladaEn       DateTime?
  facturaMotivoAnulacion String?

  // Historial de remisiones: cada vez que se anula SOLO la factura y
  // después se emite una nueva para el mismo pedido (ver Fase 11), la vieja
  // queda congelada acá antes de pisarse.
  facturasReemplazadas FacturaReemplazada[]

  /// Los documentos fiscales emitidos para este pedido (ver Comprobante): la
  /// factura vigente y, si hubo remisión, las anuladas que reemplazó.
  comprobantes Comprobante[]

  // Cada descuento (y, si se cancela, su reversión) de stock que generó
  // este pedido — ver MovimientoStock (Control de stock).
  movimientosStock MovimientoStock[]

  // El pedido se guarda ANTES de que el cliente apriete "Enviar por
  // WhatsApp". Esta marca distingue los pedidos realmente enviados de los
  // que el cliente armó y abandonó en el último paso.
  enviadoWhatsapp      Boolean       @default(false)
  subtotal             Decimal       @db.Decimal(10, 2)
  costoEnvio           Decimal       @db.Decimal(10, 2) @default(0)
  total                Decimal       @db.Decimal(10, 2)
  items                OrderItem[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([rendicionId])
  @@index([turnoPosId])
  @@unique([storeId, numero])
  @@index([storeId])
  @@index([storeId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  // Se repite el local acá (aunque se podría deducir del pedido) para que
  // el filtro automático funcione igual en todas las tablas, sin excepciones
  // que haya que recordar.
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nulo cuando el ítem es un combo "mitad y mitad" (no corresponde a un
  // único producto) — el detalle queda igual en nombreProducto.
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  nombreProducto String // snapshot: el nombre al momento del pedido
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  // Snapshot de la tasa de IVA al momento del pedido — igual que
  // VentaPosItem.iva: si el producto cambia de tasa después, las facturas
  // viejas no se mueven solas.
  iva            String  @default("gravado10")
  opcionesTexto  String? // snapshot de las opciones elegidas, en texto legible
  ingredientesQuitadosTexto String? // snapshot de ingredientes que el cliente sacó, ej: "tomate, cebolla"
  /// Snapshot de cuánto costaban (sumados) los agregados/variantes elegidos
  /// en ESTE ítem, al momento de la venta — a diferencia de Product.costo
  /// (que el reporte de rentabilidad lee siempre ACTUAL, no del día que se
  /// vendió), esto no se puede recalcular después: el pedido no guarda a
  /// cuáles opciones concretas corresponde `opcionesTexto`, solo el texto.
  /// 0 si no se eligió ningún agregado. Null si se eligió alguno pero no
  /// tenía costo cargado en ese momento — "desconocido", nunca inventado.
  /// El default en 0 es solo para los pedidos VIEJOS, de antes de que este
  /// campo existiera: siguen reportando exactamente el mismo número que
  /// hoy (no se vuelven "desconocidos" de golpe). Los pedidos nuevos
  /// siempre mandan un valor explícito desde el checkout, nunca dependen
  /// de este default.
  costoAgregados Decimal? @db.Decimal(10, 2) @default(0)
  /// Snapshot de cuánto de `precioUnitario` corresponde a agregados
  /// (nunca desconocido: a diferencia del costo, el precio de un agregado
  /// no es opcional, siempre está cargado). Existe para que el reporte de
  /// Rentabilidad pueda mostrar el precio de venta del PRODUCTO solo,
  /// siempre el mismo, sin que varíe según si esa venta puntual llevó
  /// agregados o no — antes esos Gs. de más quedaban mezclados en el
  /// precio del producto y lo mostraban como si vendiera más caro.
  precioAgregados Decimal @db.Decimal(10, 2) @default(0)
  /// Snapshot del costo del PRODUCTO en sí (sin agregados), por unidad, al
  /// momento de la venta — sale de su receta (ver src/lib/costo-receta.ts). En
  /// un combo mitad y mitad es la mitad de cada lado. Existe para que
  /// Rentabilidad use el costo del día de la venta y no el de hoy, y para poder
  /// costear los combos (el ítem no guarda cuáles son sus dos productos). Null
  /// = no se conocía al vender (sin receta, o un insumo sin costo); en esos
  /// casos el reporte cae al costo actual del producto, si lo tiene.
  costoProducto Decimal? @db.Decimal(10, 2)

  @@index([storeId])
  @@index([orderId])
}

// Horarios disponibles para reservar, agrupados por turno. Se configuran
// desde el panel (Reservas → Horarios) y son los que ve el cliente en el
// formulario público de reservas.
model HorarioReserva {
  id     String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  turno  String // "dia" | "tarde" | "noche"
  hora   String // "HH:MM", ej: "12:30"
  activo Boolean @default(true)
  orden  Int     @default(0)
  // Cuántas personas como máximo se pueden sentar en este horario.
  // NULL = sin límite (comportamiento anterior, sigue siendo el default).
  capacidadPersonas Int?

  @@unique([storeId, turno, hora])
  @@index([storeId])
}

model Reservation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Mismo criterio que Order.numero: sale de `contadorReservas` del local y
  // deliberadamente no tiene valor por defecto.
  numero          Int
  fecha           DateTime // solo día, medianoche Asunción — la mesa/fecha reservada
  turno           String // "dia" | "tarde" | "noche"
  horario         String // "HH:MM" elegido dentro del turno
  personas        Int
  motivo          String // "cumple" | "cita" | "reunion" | "aniversario" | "otro"
  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?
  estado          String   @default("pendiente") // pendiente | confirmada | cancelada
  // Nota interna del encargado — ej: "pidió globos y velitas", cargada
  // después de llamar al cliente para confirmar. No la ve el cliente.
  nota            String?
  // La reserva se guarda ANTES de que el cliente apriete "Enviar por
  // WhatsApp". Hasta que no lo aprieta, no se muestra en el calendario:
  // es una reserva que el cliente armó pero nunca llegó a pedir.
  enviadoWhatsapp Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([storeId, numero])
  @@index([storeId])
  @@index([storeId, fecha])
}

/// El cierre de caja de un repartidor.
///
/// Cuando vuelve al local, el dueño mira cuánto EFECTIVO junta entre sus
/// entregas, lo recibe, y esa vuelta queda cerrada. Los pedidos que entraron
/// en el cierre quedan atados acá y no vuelven a aparecer como pendientes.
///
/// Los totales se copian en vez de calcularse después a propósito: si mañana
/// se corrige el precio de un pedido viejo, la rendición que ya se firmó no
/// puede cambiar sola. Lo que se recibió, se recibió.
model Rendicion {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  repartidorId String
  repartidor   Repartidor @relation(fields: [repartidorId], references: [id])

  /// Cuántos pedidos entraron y cuánta plata de cada tipo, congelados.
  cantidadPedidos Int
  totalEfectivo   Decimal @db.Decimal(10, 2)
  /// Suma de transferencia + tarjeta débito + tarjeta crédito — se mantiene
  /// para lo que ya lo usa como bolsón único (comprobante de rendición).
  totalOtros      Decimal @db.Decimal(10, 2)
  /// Mismas 3 formas de "otros", desglosadas — para que el cierre general
  /// del turno (pos/turnos/[id]/page.tsx) pueda sumar cada una a su columna
  /// correspondiente de mostrador, en vez de un bolsón que no se puede
  /// repartir. Rendiciones de antes de este desglose quedan en 0 acá (no hay
  /// forma de reconstruir retroactivamente qué parte de "otros" era cada
  /// una), con el dato viejo intacto en totalOtros.
  totalTransferencia  Decimal @default(0) @db.Decimal(10, 2)
  totalTarjetaDebito  Decimal @default(0) @db.Decimal(10, 2)
  totalTarjetaCredito Decimal @default(0) @db.Decimal(10, 2)

  /// Quién lo recibió, para que después se sepa a quién preguntarle.
  recibidoPor  String
  notas        String?
  creadoEn     DateTime @default(now())

  pedidos      Order[]

  // A qué turno de caja queda atada — el mismo criterio que Order.turnoPosId
  // para retiro/mesa: se pega sola al turno abierto en la estación desde
  // donde se recibió, para que el cierre general del turno pueda sumarla.
  // Sin estación/turno vinculado (un local que no usa Punto de Venta) queda
  // en null, exactamente como funcionaba antes de esto.
  turnoPosId String?
  turnoPos   TurnoPos? @relation(fields: [turnoPosId], references: [id])

  @@index([storeId])
  @@index([repartidorId])
  @@index([turnoPosId])
}

/// El turno de caja del Punto de Venta (mostrador).
///
/// A diferencia de Rendicion (que se calcula sobre pedidos de delivery ya
/// entregados), acá el turno tiene apertura y cierre EXPLÍCITOS: el cajero
/// abre declarando el vuelto inicial, vende, y al cerrar declara cuánto tiene
/// en cada una de las 4 formas de pago. Un solo turno puede estar "abierto"
/// por ESTACIÓN a la vez (ver el índice único parcial en la migración SQL) —
/// dos estaciones del mismo local pueden tener cada una su propio turno
/// abierto en simultáneo, sin pisarse.
///
/// Los "calculado*" y "declarado*" quedan congelados al cerrar, mismo
/// criterio que Rendicion: si después se corrige algo, el cierre ya firmado
/// no se mueve solo.
model TurnoPos {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  estacionId String
  estacion   Estacion @relation(fields: [estacionId], references: [id])

  estado String @default("abierto") // "abierto" | "cerrado"

  montoInicial Decimal  @db.Decimal(10, 2) @default(0)
  abiertoPor   String
  abiertoEn    DateTime @default(now())

  cantidadVentas          Int?
  calculadoEfectivo       Decimal? @db.Decimal(10, 2)
  calculadoTransferencia  Decimal? @db.Decimal(10, 2)
  calculadoTarjetaDebito  Decimal? @db.Decimal(10, 2)
  calculadoTarjetaCredito Decimal? @db.Decimal(10, 2)

  declaradoEfectivo       Decimal? @db.Decimal(10, 2)
  declaradoTransferencia  Decimal? @db.Decimal(10, 2)
  declaradoTarjetaDebito  Decimal? @db.Decimal(10, 2)
  declaradoTarjetaCredito Decimal? @db.Decimal(10, 2)

  notas      String?
  cerradoPor String?
  cerradoEn  DateTime?

  /// Lo que entró menos lo que salió de la caja en efectivo durante el turno
  /// (ingresos − retiros, ver MovimientoCaja), congelado al cerrar. Suma al
  /// efectivo que tendría que haber en la caja. Null en los turnos anteriores
  /// a esta función y en los que siguen abiertos (se calcula en vivo).
  movimientosEfectivoNeto Decimal? @db.Decimal(12, 2)
  movimientosCaja         MovimientoCaja[]

  ventas  VentaPos[]
  // Pedidos de retiro/mesa cobrados en este turno (ver Order.turnoPosId) —
  // el mismo cierre que las ventas de mostrador, no uno aparte.
  pedidos Order[]
  // Rendiciones de repartidor recibidas mientras este turno estaba abierto
  // (ver Rendicion.turnoPosId) — el corte general del turno las suma aparte,
  // sin mezclar sus formas de cobro (efectivo/tarjeta/transferencia/ya
  // pagado) con las 4 de mostrador, que no son exactamente lo mismo.
  rendiciones Rendicion[]

  @@index([storeId])
  @@index([storeId, estado])
  @@index([estacionId])
}

/// Una notebook/caja física del local — la unidad de concurrencia del POS.
/// Vinculada a un navegador por cookie (ver src/lib/estacion-actual.ts), no
/// a un usuario: cualquier cajero que abra el panel desde esa computadora
/// opera bajo esta estación.
model Estacion {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  activa    Boolean    @default(true)
  createdAt DateTime   @default(now())
  turnos    TurnoPos[]

  // Sin punto asignado, esta estación solo puede vender como Ticket (no
  // Factura) — ver PuntoExpedicion.
  puntoExpedicionId String?
  puntoExpedicion   PuntoExpedicion? @relation(fields: [puntoExpedicionId], references: [id])

  // Qué Área de Impresión maneja el ticket/factura EN ESTA estación — la
  // impresora real se resuelve igual que cualquier otra área, vía
  // EstacionImpresora (estacionId, areaTicketId). Null = ticket sin
  // impresión automática, cae al fallback manual.
  areaTicketId String?
  areaTicket   AreaImpresion? @relation(fields: [areaTicketId], references: [id], onDelete: SetNull)
  // Mapeo de cada Área de Impresión a la impresora real que QZ Tray ve EN
  // ESTA notebook — una fila por área configurada (ver EstacionImpresora).
  impresoras   EstacionImpresora[]

  @@index([storeId])
}

/// Un "destino" de impresión configurable (Cocina, Barra, Caja...). Cada
/// Product se asocia a una (ver Product.areaImpresionId) y cada Estacion
/// mapea cada área a la impresora real que ve esa notebook (ver
/// EstacionImpresora) — el mapeo NO se comparte entre estaciones porque
/// Windows puede nombrar la misma impresora de red distinto en cada una.
model AreaImpresion {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  productos          Product[]
  impresorasEstacion EstacionImpresora[]
  estacionesTicket   Estacion[]

  @@index([storeId])
}

/// Para una Estacion puntual, qué impresora real (nombre EXACTO tal cual lo
/// reporta qz.printers.find() en esa notebook) maneja cada Área de
/// Impresión — no es un catálogo, es lo que esa máquina ve en ese momento.
model EstacionImpresora {
  id         String   @id @default(cuid())
  // Se repite el local acá (aunque se podría deducir de la estación) para
  // que el filtro automático funcione igual en todas las tablas — mismo
  // criterio que OrderItem/VentaPosItem.
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  estacionId String
  estacion   Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)
  areaImpresionId String
  areaImpresion   AreaImpresion @relation(fields: [areaImpresionId], references: [id], onDelete: Cascade)
  nombreImpresora String

  @@unique([estacionId, areaImpresionId])
  @@index([storeId])
  @@index([estacionId])
}

/// Un punto de expedición autorizado por la DNIT para Factura Autoimpresor.
/// Una o varias Estacion pueden usar el MISMO punto de expedición (comparten
/// numeración) o cada una el suyo (numeran por separado) — lo decide el
/// dueño asignándolo en /admin/pos/estaciones, no hay lógica especial acá.
model PuntoExpedicion {
  id              String     @id @default(cuid())
  storeId         String
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre          String // etiqueta interna, ej "Mostrador"
  establecimiento String // 3 dígitos, ej "001"
  puntoExpedicion String // 3 dígitos, ej "001"
  numeroTimbrado  String
  timbradoDesde   DateTime
  timbradoHasta   DateTime

  // La razón social/RUC del EMISOR (el negocio, a nombre de quién la DNIT
  // autorizó el timbrado) que va impresa en la factura — distinto de
  // Store.razonSocial/ruc, que son datos internos de TuMenuSmart para
  // facturarle al dueño y ni siquiera se le muestran a él en su panel.
  razonSocialEmisor String
  rucEmisor         String

  // Cuántas facturas ya salieron de este punto — mismo patrón que
  // Store.contadorVentasPos: arranca en 0, se incrementa ATÓMICAMENTE y el
  // valor YA incrementado es el número que le toca a esa factura (nunca se
  // lee primero y se incrementa después, porque entre esas dos operaciones
  // dos ventas en simultáneo podrían agarrar el mismo número).
  ultimoNumeroFactura Int @default(0)

  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  estaciones   Estacion[]
  comprobantes Comprobante[]

  @@index([storeId])
}

/// Una cuenta cobrada en el mostrador (venta rápida de POS).
model VentaPos {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  turnoPosId    String
  turnoPos      TurnoPos @relation(fields: [turnoPosId], references: [id])
  // Mismo criterio que Order.numero: sale de contadorVentasPos del local y
  // deliberadamente no tiene valor por defecto.
  numero        Int
  /// RESUMEN de cómo se pagó: la forma única ("efectivo" | "transferencia" |
  /// "tarjeta_debito" | "tarjeta_credito" | "a_credito"), o "mixto" si se
  /// dividió entre varias. El detalle y los montos están en `pagos`.
  formaPago     String
  /// Lo que se cobró, YA con el descuento general restado.
  total         Decimal  @db.Decimal(10, 2)
  /// Descuento general de la cuenta, en guaraníes (0 = sin descuento). Lo que
  /// sumaban los ítems es total + descuento; los ítems guardan su precio sin
  /// descuento, así el ticket muestra lo que se pidió. El IVA de la factura ya
  /// se calculó sobre lo cobrado (ver desglosarIva).
  descuento     Decimal  @default(0) @db.Decimal(10, 2)
  /// Solo si el descuento se cargó como porcentaje (ej. 10): para imprimir
  /// "DESCUENTO 10%". Null si fue un monto fijo o no hubo descuento.
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  registradoPor String
  creadoEn      DateTime @default(now())
  items         VentaPosItem[]

  // Opcionales: mucha venta de mostrador es un cliente de paso que no vale
  // la pena frenar para pedirle el teléfono. Cuando SÍ se carga, cuenta
  // para el mismo programa de fidelización que los pedidos online (ver
  // src/lib/fidelidad.ts) — mismo criterio de "guardado tal cual lo tipea"
  // que ya usa Order.clienteTelefono, para que las dos fuentes sumen al
  // mismo cliente sin tener que reformatear nada.
  clienteNombre   String?
  clienteTelefono String?
  // "local" (se consume ahí) | "llevar" (para llevar, necesita empaque).
  tipoEntrega     String  @default("local")
  nota            String?

  // Anular una cuenta ya cobrada (se cargó mal, el cliente se arrepintió,
  // etc.) sin borrar el registro — deja rastro de quién y por qué. Solo se
  // permite mientras el turno (turnoPos) sigue "abierto": una vez cerrado,
  // el cajero ya declaró esos montos en el corte ciego, así que
  // cancelarVenta (pos/actions.ts) rechaza la anulación en vez de dejar
  // tocar una cuenta que ya quedó firmada en un cierre.
  cancelada         Boolean   @default(false)
  canceladaPor      String?
  canceladaEn       DateTime?
  motivoCancelacion String?

  /// Solo si la venta fue "a_credito": hasta cuándo tiene el cliente para
  /// pagar (el día, guardado a medianoche UTC). Lo que se debe es `total`
  /// menos la suma de sus cobros (CobroVenta): el saldo no se guarda.
  fechaVencimientoCredito DateTime?
  cobros                  CobroVenta[]

  /// Cómo se pagó ESTA venta: una fila por cada forma de pago usada (pago
  /// dividido: 50.000 en efectivo + 50.000 con débito = dos filas). Siempre
  /// hay al menos una, y la suma de sus montos es exactamente `total`. Es la
  /// FUENTE DE VERDAD de la caja, el cierre de turno y los reportes por forma
  /// de pago; `formaPago` (arriba) queda solo como resumen para listar.
  pagos                   PagoVenta[]

  // Mismos campos informales que Order ya tiene: lo que pide el cliente
  // para que le facturen. "ticket" | "factura".
  comprobanteTipo    String  @default("ticket")
  facturaRazonSocial String? // null si facturaTipoIdentificacion es "sin_nombre" (Consumidor Final)
  // Número de identificación del comprador, sea cual sea el tipo (RUC,
  // Cédula, Pasaporte, "X" para Sin Nombre, etc. — ver facturaTipoIdentificacion
  // y src/lib/tipo-cliente.ts). El nombre del campo quedó de la Fase 3,
  // cuando solo existía RUC; el ticket usa etiquetaTipoIdentificacion() para
  // imprimir la etiqueta correcta en vez de "RUC" fijo.
  facturaRuc         String?
  // Clasificación fiscal SET del comprador (Tabla 3, RG 90/2021) — "ruc" |
  // "cedula" | "pasaporte" | "cedula_extranjera" | "diplomatico" |
  // "identificacion_tributaria" | "sin_nombre". Null en facturas viejas de
  // antes de la Fase 5, donde solo se guardaba RUC a secas.
  facturaTipoIdentificacion String?

  // Fiscales — se completan y se CONGELAN solo cuando comprobanteTipo pasa
  // a "factura" (ver registrarVenta en pos/actions.ts). Nunca se recalculan
  // después, mismo criterio que TurnoPos.calculado*/Rendicion.
  facturaNumero      String? // "001-001-0000001", ya formateado
  facturaTimbrado    String?
  facturaVencimiento DateTime?
  facturaGravado10   Decimal?  @db.Decimal(10, 2)
  facturaGravado5    Decimal?  @db.Decimal(10, 2)
  facturaExento      Decimal?  @db.Decimal(10, 2)
  facturaIva10       Decimal?  @db.Decimal(10, 2)
  facturaIva5        Decimal?  @db.Decimal(10, 2)
  // A diferencia de Order, esto quedaba SIN congelar — el ticket lo leía en
  // vivo vía turnoPos.estacion.puntoExpedicion. Frágil (si la estación
  // cambia de punto de expedición después, un ticket viejo imprime mal) y
  // roto de frente para una remisión (Fase 11): la venta se re-emite desde
  // la estación ACTUAL, no la del turno original. Se congela acá también,
  // igual que Order, tanto en la emisión normal como en la remisión.
  facturaRazonSocialEmisor String?
  facturaRucEmisor         String?

  // Anular SOLO la factura, sin cancelar la cuenta — mismo criterio que
  // Order.facturaAnulada (ver ese comentario). Cancelar la cuenta entera
  // SIGUE anulando la factura de yapa (ver cancelarVenta); esto agrega el
  // camino inverso: anular solo el número, cuenta viva.
  facturaAnulada         Boolean   @default(false)
  facturaAnuladaPor      String?
  facturaAnuladaEn       DateTime?
  facturaMotivoAnulacion String?

  // Historial de remisiones — ver Order.facturasReemplazadas.
  facturasReemplazadas FacturaReemplazada[]

  /// Los documentos fiscales emitidos para esta venta (ver Comprobante).
  comprobantes Comprobante[]

  // Ver Order.movimientosStock.
  movimientosStock MovimientoStock[]

  /// La cita de la agenda que se cobró con esta venta, si es el caso (ver Cita.ventaPosId).
  cita Cita?

  @@index([storeId])
  @@index([turnoPosId])
  @@index([storeId, creadoEn])
}

model VentaPosItem {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ventaPosId     String
  ventaPos       VentaPos @relation(fields: [ventaPosId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  nombreProducto String   // snapshot: el nombre al momento de la venta
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  // Snapshot de la tasa de IVA al momento de la venta — igual que
  // nombreProducto/precioUnitario: si el producto cambia de tasa después,
  // las facturas viejas no se mueven solas.
  iva            String   @default("gravado10")
  // Snapshot de los agregados elegidos, en texto legible — igual que
  // OrderItem.opcionesTexto. Null si no se eligió ninguno.
  opcionesTexto  String?
  /// Snapshot del costo del PRODUCTO en sí (sin agregados), por unidad, al
  /// momento de la venta — sale de su receta. Null = no se conocía (sin receta
  /// o con algún insumo sin costo). Mismo criterio que OrderItem.costoProducto.
  costoProducto  Decimal? @db.Decimal(10, 2)
  /// Snapshot de cuánto costaron (sumados) los agregados elegidos en este
  /// ítem, por unidad. 0 si no se eligió ninguno; null = desconocido. Igual
  /// que OrderItem.costoAgregados. Los ítems viejos con agregados quedan en
  /// null (no se guardaba); los viejos sin agregados se pasaron a 0.
  costoAgregados Decimal? @db.Decimal(10, 2)
  /// Cuánto de `precioUnitario` corresponde a agregados — igual que
  /// OrderItem.precioAgregados, para que Rentabilidad separe producto y
  /// agregados también en el mostrador.
  precioAgregados Decimal @db.Decimal(10, 2) @default(0)

  @@index([storeId])
  @@index([ventaPosId])
}

/// Un documento fiscal emitido: hoy la Factura Autoimpresor; mañana la factura
/// electrónica (SIFEN, a través de un proveedor), notas de crédito, etc.
///
/// Es una FOTO del documento tal como salió — emisor, comprador, numeración,
/// montos y líneas — que nunca se recalcula. Todo lo que un proveedor de
/// factura electrónica (o un reporte fiscal como el RG 90) necesita está acá,
/// sin tener que juntar datos de ventas, pedidos, clientes y productos.
///
/// Sigue la estructura del Documento Electrónico de SIFEN (esquema oficial
/// DE_v150.xsd de la DNIT): cada campo dice, en su comentario, a qué campo del
/// DE corresponde. Se guardan valores SEMÁNTICOS ("factura", "contado",
/// "efectivo"…), no los códigos numéricos de la DNIT — la traducción a esos
/// códigos vive en src/lib/sifen-codigos.ts, mismo criterio que
/// tipo-cliente.ts.
///
/// Una venta o un pedido puede tener varios a lo largo del tiempo (una factura
/// anulada y su remisión): el que rige es el de `estado = "vigente"`. Debe
/// tener origen: exactamente una de ventaPosId / orderId (lo exige un CHECK en
/// la migración).
model Comprobante {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// De qué cuenta salió: la venta del mostrador…
  ventaPosId String?
  ventaPos   VentaPos? @relation(fields: [ventaPosId], references: [id], onDelete: Cascade)
  /// …o el pedido online.
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // --- gTimb: tipo, timbrado y numeración ---
  /// "factura" | "autofactura" | "nota_credito" | "nota_debito" | "nota_remision" (iTiDE).
  tipo         String  @default("factura")
  /// "autoimpresor" (talonario autorizado por la DNIT, como hoy) | "electronico" (SIFEN).
  modalidad    String  @default("autoimpresor")
  /// "normal" | "contingencia" (iTipEmi).
  tipoEmision  String  @default("normal")
  /// El punto de expedición del que salió el número.
  puntoExpedicionId String?
  puntoDeExpedicion PuntoExpedicion? @relation(fields: [puntoExpedicionId], references: [id], onDelete: SetNull)
  /// Número de timbrado (dNumTim, 8 dígitos) y desde cuándo rige (dFeIniT).
  timbrado         String
  timbradoDesde    DateTime?
  timbradoHasta    DateTime
  /// dEst y dPunExp: 3 dígitos cada uno.
  establecimiento  String
  punto            String
  /// dNumDoc: el correlativo (1, 2, 3…), 7 dígitos con ceros. `numero` es el
  /// documento completo con formato: "001-001-0000001".
  correlativo      Int
  numero           String
  /// Cuándo se emitió (dFeEmiDE).
  fechaEmision     DateTime @default(now())

  // --- gOpeCom: la operación ---
  /// "venta_mercaderia" | "prestacion_servicios" | "mixto" (iTipTra).
  tipoTransaccion  String  @default("venta_mercaderia")
  /// Moneda de la operación (cMoneOpe): siempre guaraníes hoy.
  moneda           String  @default("PYG")

  // --- gEmis: el emisor (foto) ---
  emisorRuc         String
  emisorRazonSocial String
  /// Los demás datos del emisor que pide SIFEN (dirección, actividades…), tal
  /// como estaban cargados al emitir (copia de EmisorFiscal). Nulo si el local
  /// no los tiene cargados: en la factura autoimpresor no hacen falta.
  emisorDatos       Json?

  // --- gDatRec: el comprador (foto) ---
  /// Clasificación del comprador (ver src/lib/tipo-cliente.ts): "ruc" |
  /// "cedula" | "pasaporte" | "cedula_extranjera" | "diplomatico" |
  /// "identificacion_tributaria" | "sin_nombre" (innominado).
  receptorTipoIdentificacion   String
  receptorNumeroIdentificacion String
  /// dNomRec. Nulo si es "sin_nombre".
  receptorRazonSocial          String?
  /// dEmailRec.
  receptorEmail                String?

  // --- gCamFE / gCamCond: presencia y condición ---
  /// "presencial" | "electronica" | "telemarketing" | "domicilio" | "bancaria" | "ciclica" | "otro" (iIndPres).
  presencia   String  @default("presencial")
  /// "contado" | "credito" (iCondOpe).
  condicion   String  @default("contado")
  /// Solo si es a crédito: hasta cuándo tiene el cliente para pagar.
  fechaVencimientoCredito DateTime?

  // --- gTotSub: totales, en guaraníes, IVA incluido ---
  /// Subtotales por tasa, ya con el descuento restado (dSub10, dSub5, dSubExe).
  gravado10 Decimal @db.Decimal(18, 2)
  gravado5  Decimal @db.Decimal(18, 2)
  exento    Decimal @db.Decimal(18, 2)
  /// IVA contenido en cada base (dLiqTotIVA10, dLiqTotIVA5).
  iva10     Decimal @db.Decimal(18, 2)
  iva5      Decimal @db.Decimal(18, 2)
  /// Descuento total aplicado (suma de los `descuento` de los ítems).
  descuento Decimal @default(0) @db.Decimal(18, 2)
  /// Lo que se facturó (dTotGralOpe).
  total     Decimal @db.Decimal(18, 2)

  // --- Estado ---
  /// "vigente" | "anulado".
  estado          String    @default("vigente")
  anuladoPor      String?
  anuladoEn       DateTime?
  motivoAnulacion String?

  /// Si se emitió EN LUGAR de otro comprobante anulado (remisión): cuál.
  reemplazaAId   String?      @unique
  reemplazaA     Comprobante? @relation("Remision", fields: [reemplazaAId], references: [id])
  reemplazadoPor Comprobante? @relation("Remision")

  emitidoPor String
  createdAt  DateTime @default(now())

  items ComprobanteItem[]

  @@index([storeId, fechaEmision])
  @@index([storeId, numero])
  @@index([ventaPosId])
  @@index([orderId])
}

/// Los datos del contribuyente que la factura ELECTRÓNICA (SIFEN) exige del
/// emisor y que la autoimpresor no usa: por eso son todos opcionales y solo se
/// piden a los locales que van a emitir electrónico. Uno por local. Se copian
/// dentro de cada Comprobante (emisorDatos) al emitirlo.
///
/// Los campos siguen el grupo gEmis del Documento Electrónico (DE_v150.xsd).
model EmisorFiscal {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// "persona_fisica" | "persona_juridica" (iTipCont).
  tipoContribuyente  String?
  /// Tipo de régimen (cTipReg), del 1 al 8. Opcional.
  tipoRegimen        Int?
  /// dNomFanEmi.
  nombreFantasia     String?
  /// dDenSuc: nombre comercial de la sucursal (hasta 30 caracteres).
  denominacionSucursal String?
  /// dTelEmi (6 a 15 caracteres) y dEmailE.
  telefono           String?
  email              String?

  // --- Dirección del establecimiento emisor ---
  /// dDirEmi y dNumCas (0 si no tiene número).
  direccion          String?
  numeroCasa         String?
  /// dCompDir1: entre calles, piso, etc.
  complemento        String?
  /// Nombre del departamento tal cual la lista oficial ("Central", "Alto Paraná"…);
  /// el código de SIFEN se calcula al armar el documento (ver src/lib/emisor-fiscal.ts).
  departamento       String?
  /// Distrito y ciudad: código y nombre según la Tabla 2.1 de la DNIT
  /// (Departamentos, Distritos y Ciudades). La ciudad es obligatoria en el DE.
  distritoCodigo     Int?
  distrito           String?
  ciudadCodigo       Int?
  ciudad             String?

  /// Actividades económicas (gActEco, de 1 a 9): [{ codigo: "56101", descripcion: "Restaurantes" }].
  actividades        Json?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Una línea de un Comprobante (gCamItem del DE): la foto de lo facturado,
/// con su unidad de medida y su tasa de IVA congeladas.
model ComprobanteItem {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  comprobanteId String
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  orden         Int         @default(0)

  /// dCodInt: código interno (el id del producto de la carta). Nulo en un
  /// combo mitad y mitad y en el costo de envío, que no son un producto único.
  codigo         String?
  /// dDesProSer: el nombre, con los agregados entre paréntesis.
  descripcion    String
  /// "unidad" | "kilogramo" | "litro" (cUniMed; código en src/lib/unidad-medida.ts).
  unidadMedida   String      @default("unidad")
  /// dCantProSer.
  cantidad       Decimal     @db.Decimal(18, 8)
  /// dPUniProSer: precio de UNA unidad de lista, IVA incluido.
  precioUnitario Decimal     @db.Decimal(18, 2)
  /// dDescItem: descuento de la línea (el descuento general de la cuenta,
  /// repartido en proporción entre todas las líneas).
  descuento      Decimal     @default(0) @db.Decimal(18, 2)
  /// dTotOpeItem: cantidad × precio − descuento, IVA incluido.
  total          Decimal     @db.Decimal(18, 2)
  /// "gravado10" | "gravado5" | "exento" (iAfecIVA + dTasaIVA).
  iva            String

  @@index([storeId])
  @@index([comprobanteId])
}

/// Snapshot de una factura anulada justo antes de reemplazarla por una
/// nueva (remisión, Fase 11) — Order/VentaPos solo tienen lugar para UN
/// número de factura vigente a la vez, así que la que se anula y se
/// reemplaza queda congelada acá antes de pisarse. El número viejo nunca
/// se reutiliza (sale de PuntoExpedicion.ultimoNumeroFactura, que solo
/// incrementa); esta tabla es el rastro de A QUÉ pedido/venta perteneció.
model FacturaReemplazada {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  origen  String // "pedido" | "venta"
  orderId String?
  order   Order?    @relation(fields: [orderId], references: [id])
  ventaId String?
  venta   VentaPos? @relation(fields: [ventaId], references: [id])

  // Lo que decía la factura ANULADA, congelado antes de pisarlo.
  facturaNumero             String
  facturaTimbrado           String?
  facturaVencimiento        DateTime?
  facturaRazonSocial        String?
  facturaRuc                String?
  facturaTipoIdentificacion String?
  anuladaPor      String
  anuladaEn       DateTime
  motivoAnulacion String

  // La factura nueva que la reemplazó, y quién/cuándo hizo la remisión.
  facturaNuevaNumero String
  remitidaPor         String
  remitidaEn          DateTime @default(now())

  @@index([storeId])
  @@index([orderId])
  @@index([ventaId])
}

// ===========================================================================
//  Control de stock
// ===========================================================================
//
// Insumos/artículos (materia prima) separados del catálogo de Productos que
// se vende. Cada Product puede armar su propia "receta" (RecetaItem): qué
// insumos consume y cuánto de cada uno. Un "extra"/agregado de grupo (ver
// OptionGroupProduct) es también un Product, así que arma su receta en su
// propia ficha, sin ningún mecanismo aparte.
//
// Todo movimiento de stock (venta, compra, ajuste de inventario, o la
// reversión de una venta cancelada) queda como una fila en MovimientoStock
// — es el ledger/auditoría, y la fuente de verdad si algún día hace falta
// recalcular. Insumo.stockActual es un espejo rápido de ese ledger, que se
// actualiza SIEMPRE junto con el movimiento, nunca solo.

model CategoriaInsumo {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  insumos Insumo[]

  @@index([storeId])
}

model Insumo {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoriaId  String?
  categoria    CategoriaInsumo? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  nombre       String
  // "unidad" | "kilogramo" | "litro" — mismo whitelist que Product.unidadMedida,
  // ver src/lib/unidad-medida.ts.
  unidadMedida String           @default("unidad")
  // "gravado10" | "gravado5" | "exento" — mismo whitelist que Product.iva,
  // ver src/lib/iva.ts. Dato fiscal del insumo en sí (lo que paga el
  // negocio al comprarlo) — cada línea de Compra lo copia como snapshot al
  // momento de registrarse, para poder armar una factura de compra fiscal.
  iva          String           @default("gravado10")
  /// Cuántas unidades del insumo (en su unidadMedida) trae UNA unidad de
  /// compra. Ej: la lata de cerveza se compra en pack de 12 → rendimiento 12:
  /// comprar 10 packs suma 120 latas al stock. Con 1 (el default) se compra
  /// y se cuenta en la misma unidad, como antes.
  rendimiento  Decimal          @default(1) @db.Decimal(12, 3)
  /// Espejo del ledger (MovimientoStock) para lectura rápida — se actualiza
  /// siempre en la misma transacción que un movimiento, nunca por su cuenta.
  /// Puede quedar negativo: una venta nunca se bloquea por falta de stock,
  /// el negativo es el aviso para revisar después.
  stockActual   Decimal  @default(0) @db.Decimal(12, 3)
  /// Umbral opcional para avisos de "stock bajo" — todavía no dispara nada
  /// automático, es un dato para la pantalla de inventario.
  stockMinimo   Decimal? @db.Decimal(12, 3)
  /// Costo de reposición: se actualiza solo con el costo unitario de la
  /// última Compra registrada de este insumo.
  costoUnitario Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  /// Preparación propia (salsa de tomate, masa, aderezo…): no se compra, se
  /// arma con otros insumos (IngredienteElaborado). No lleva stock propio: al
  /// vender, su consumo se "abre" en los insumos con que se prepara (ver
  /// src/lib/insumo-elaborado.ts) y son ESOS los que bajan. Su costo tampoco
  /// se guarda: sale de sus ingredientes. No cambia después de creado.
  esElaborado   Boolean  @default(false)
  /// Cuánto rinde UNA tanda de la receta, en la unidad de medida del propio
  /// insumo (ej: la tanda de salsa rinde 4 litros). Solo para preparaciones.
  rindeTanda    Decimal? @db.Decimal(12, 3)

  receta      RecetaItem[]
  compraItems CompraItem[]
  movimientos MovimientoStock[]
  inventarioItems InventarioItem[]
  /// Con qué se prepara (solo si esElaborado).
  ingredientes      IngredienteElaborado[] @relation("PreparacionIngredientes")
  /// En qué preparaciones se usa este insumo como ingrediente.
  usadoEnElaborados IngredienteElaborado[] @relation("IngredienteDePreparacion")

  @@index([storeId])
  @@index([categoriaId])
}

/// Un ingrediente de una preparación (Insumo con esElaborado): cuánto lleva UNA
/// tanda, en la unidad del ingrediente. El ingrediente puede ser un insumo
/// común o, a su vez, otra preparación (nunca en círculo: se valida al guardar).
model IngredienteElaborado {
  id            String @id @default(cuid())
  storeId       String
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  elaboradoId   String
  elaborado     Insumo @relation("PreparacionIngredientes", fields: [elaboradoId], references: [id], onDelete: Cascade)
  ingredienteId String
  ingrediente   Insumo @relation("IngredienteDePreparacion", fields: [ingredienteId], references: [id], onDelete: Cascade)
  cantidad      Decimal @db.Decimal(12, 3)

  @@unique([elaboradoId, ingredienteId])
  @@index([storeId])
  @@index([elaboradoId])
  @@index([ingredienteId])
}

/// Producto ↔ Insumo: qué consume UN Product por cada unidad vendida de él.
/// Sirve igual para un plato de la carta que para un "extra" (que ya es un
/// Product real, ver OptionGroupProduct) — no hay caso especial.
model RecetaItem {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  cantidad  Decimal @db.Decimal(12, 3)

  @@unique([productId, insumoId])
  @@index([storeId])
  @@index([productId])
  @@index([insumoId])
}

model Proveedor {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Nombre comercial — con el que el negocio lo reconoce a diario. El
  /// único obligatorio: los demás datos fiscales pueden no tenerse a mano
  /// (proveedor informal) sin que eso impida cargarlo.
  nombre       String
  /// Razón social — el nombre legal/fiscal, puede ser distinto del
  /// comercial (ej: "Distribuidora del Este S.A." vs. "Don Pedro Bebidas").
  razonSocial  String?
  ruc          String?
  telefono     String?
  ciudad       String?
  email        String?
  notas        String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  compras Compra[]
  gastos  Gasto[]

  @@index([storeId])
}

/// Almacenes/depósitos (ej: "Almacén Cocina", "Almacén Bodega"). El stock de
/// un Insumo se reparte por almacén: cada MovimientoStock lleva el suyo, y
/// lo que hay en un almacén es la suma de sus movimientos (ver
/// src/lib/stock-almacen.ts). Insumo.stockActual sigue siendo el TOTAL de
/// todos los almacenes. Cada compra entra a un almacén (CompraItem.almacenId)
/// y cada producto descuenta del suyo al venderse (Product.almacenId).
model Almacen {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  compraItems CompraItem[]
  movimientos MovimientoStock[]
  inventarios Inventario[]
  productos   Product[]

  @@index([storeId])
}

model Compra {
  id                String     @id @default(cuid())
  storeId           String
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  proveedorId       String?
  proveedor         Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  /// Folio de la factura del proveedor (no un número propio del sistema).
  numeroComprobante String?
  /// Timbrado de esa factura (hasta 8 dígitos). Lo pide el registro de
  /// comprobantes de COMPRAS de la DNIT (RG 90). Opcional: una compra sin
  /// factura no lo tiene y simplemente no entra a ese registro.
  timbrado          String?
  fecha             DateTime   @default(now())
  /// "contado" | "credito".
  condicionPago     String     @default("contado")
  /// Solo tiene sentido con condicionPago "credito" — cuándo vence el pago.
  fechaVencimiento  DateTime?
  /// Descuento sobre el total de la factura completa, además de los
  /// descuentos por línea (CompraItem.descuentoPorcentaje).
  descuentoGeneralPorcentaje Decimal? @db.Decimal(5, 2)
  total             Decimal    @db.Decimal(10, 2)
  notas             String?
  registradoPor     String?
  createdAt         DateTime   @default(now())

  // Anular una compra ya registrada le devuelve el stock a sus insumos
  // (ver MovimientoStock tipo "cancelacion") — mismo criterio que
  // VentaPos.cancelada: nunca se borra la fila, queda quién y por qué.
  cancelada         Boolean    @default(false)
  canceladaPor      String?
  canceladaEn       DateTime?
  motivoCancelacion String?

  items       CompraItem[]
  movimientos MovimientoStock[]
  /// Lo que se le fue pagando al proveedor de una compra a crédito (ver PagoCompra).
  pagos       PagoCompra[]

  @@index([storeId])
  @@index([proveedorId])
}

/// Un presupuesto / cotización para enviarle a un cliente (PDF). Es solo el
/// documento y su registro: no mueve stock ni caja y no es un comprobante
/// fiscal. Cada línea copia el nombre y el precio del momento, así un
/// presupuesto ya enviado no cambia si después se edita el producto.
model Cotizacion {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Correlativo propio de cada local (Store.contadorCotizaciones).
  numero  Int
  fecha   DateTime @default(now())
  /// Días de validez contados desde `fecha`: el PDF dice "válido hasta" ese día.
  validezDias Int  @default(15)
  clienteNombre         String
  /// RUC o cédula tal como se escribió: texto libre, no se valida.
  clienteIdentificacion String?
  clienteTelefono       String?
  clienteEmail          String?
  /// Condiciones u observaciones que salen al pie del PDF.
  notas   String?
  /// Descuento general en guaraníes (ya calculado) y, si se pidió en %, el porcentaje.
  descuento           Decimal  @default(0) @db.Decimal(14, 2)
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  /// Lo que hay que pagar: con IVA y ya con el descuento.
  total     Decimal  @db.Decimal(14, 2)
  creadaPor String?
  createdAt DateTime @default(now())

  items CotizacionItem[]

  @@unique([storeId, numero])
  @@index([storeId])
}

model CotizacionItem {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  orden        Int        @default(0)
  nombre       String
  /// Detalle opcional que sale debajo del nombre (ej: "incluye mano de obra").
  descripcion  String?
  cantidad     Decimal    @db.Decimal(10, 2)
  /// Precio de UNA unidad, con IVA incluido.
  precioUnitario Decimal  @db.Decimal(14, 2)
  /// "gravado10" | "gravado5" | "exento" — ver src/lib/iva.ts.
  iva          String     @default("gravado10")

  @@index([storeId])
  @@index([cotizacionId])
}

/// Bitácora del sistema: quién hizo qué y cuándo. Cada fila es una acción
/// importante de un usuario (cancelar una venta, anular una factura, cargar una
/// compra, cambiar un precio…). Solo se agrega: nunca se edita ni se borra, para
/// que sirva de rastro. `descripcion` es la frase que se lee en pantalla;
/// `detalle` guarda los datos de apoyo (montos, antes y después) como JSON en texto.
model Bitacora {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Cómo se llamaba quien lo hizo (nombre, o su correo si no tiene) y su correo,
  /// copiados en ese momento: el rastro no cambia si después se renombra.
  usuario      String
  usuarioEmail String
  /// Su rol en ese momento ("local", "empleado", "superadmin").
  usuarioRol   String?
  /// El área del sistema: "ventas", "caja", "facturas", "stock", "compras"…
  modulo       String
  /// Qué hizo, en código corto ("venta_cancelada", "factura_anulada"…).
  accion       String
  descripcion  String
  /// Sobre qué registro fue (por ejemplo "VentaPos" y su id), si aplica.
  entidad      String?
  entidadId    String?
  detalle      String?
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, modulo])
  @@index([storeId, usuarioEmail])
}

/// Plata que entra a la caja (ingreso) o sale de ella (retiro) en efectivo
/// durante un turno, aparte de las ventas: cambio que se repone, un gasto
/// pagado del cajón, el retiro del dueño, un cobro de cuenta a crédito en
/// efectivo... Suma o resta al efectivo que tendría que haber al cerrar. El
/// signo lo da el tipo: `monto` siempre es positivo.
model MovimientoCaja {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  turnoPosId    String
  turnoPos      TurnoPos @relation(fields: [turnoPosId], references: [id])
  /// "ingreso" | "retiro"
  tipo          String
  monto         Decimal  @db.Decimal(12, 2)
  /// Para qué fue — obligatorio: dentro de un mes nadie se acuerda.
  concepto      String
  registradoPor String
  createdAt     DateTime @default(now())

  /// Si este ingreso es el cobro en efectivo de una venta a crédito.
  cobroVentaId  String?      @unique
  cobroVenta    CobroVenta?  @relation(fields: [cobroVentaId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([turnoPosId])
}

/// Un cobro de una venta hecha a crédito (cuentas por cobrar): el cliente
/// paga total o parcialmente lo que debe. Lo que falta cobrar de una venta es
/// su total menos la suma de sus cobros. Un cobro en efectivo con turno
/// abierto genera además un ingreso de caja (MovimientoCaja).
/// Una parte del pago de una venta del mostrador — ver VentaPos.pagos. Es lo
/// mismo que después pide la factura electrónica (condición de la operación y
/// cada forma de pago con su monto), así que ya queda con esa forma.
model PagoVenta {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ventaPosId String
  ventaPos   VentaPos @relation(fields: [ventaPosId], references: [id], onDelete: Cascade)
  /// "efectivo" | "transferencia" | "tarjeta_debito" | "tarjeta_credito" | "a_credito"
  /// ("a_credito" solo puede ser la única fila de la venta).
  forma      String
  /// Lo que se cobró con esta forma, en guaraníes (no el "paga con": el vuelto no se guarda).
  monto      Decimal  @db.Decimal(12, 2)
  /// Para mostrarlas en el mismo orden en que se cargaron.
  orden      Int      @default(0)

  @@index([storeId])
  @@index([ventaPosId])
}

model CobroVenta {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ventaPosId    String
  ventaPos      VentaPos @relation(fields: [ventaPosId], references: [id], onDelete: Cascade)
  monto         Decimal  @db.Decimal(12, 2)
  /// El día en que se cobró (a medianoche UTC), no cuándo se cargó al sistema.
  fecha         DateTime
  /// "efectivo" | "transferencia" | "tarjeta_debito" | "tarjeta_credito"
  formaPago     String
  notas         String?
  registradoPor String
  createdAt     DateTime @default(now())

  movimientoCaja MovimientoCaja?

  @@index([storeId])
  @@index([ventaPosId])
}

/// Un pago al proveedor por una compra a crédito (cuentas por pagar). Lo que
/// se debe de una compra es su total menos la suma de sus pagos: no se guarda
/// el saldo, se calcula. Si un pago se cargó mal se elimina y se vuelve a cargar.
model PagoCompra {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  compraId      String
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  /// Con IVA, igual que Compra.total.
  monto         Decimal  @db.Decimal(10, 2)
  /// El día en que se pagó (no cuándo se cargó al sistema).
  fecha         DateTime
  /// "efectivo" | "transferencia" | "cheque" | "otro".
  formaPago     String   @default("efectivo")
  notas         String?
  registradoPor String?
  createdAt     DateTime @default(now())

  @@index([storeId])
  @@index([compraId])
}

model CompraItem {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  compraId      String
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumoId      String
  // Restrict, no Cascade: borrar un insumo nunca debería borrar de yapa el
  // historial de lo que se compró de él. En la práctica Insumo se
  // desactiva (campo `activo`), no se borra — mismo patrón que Proveedor/
  // AreaImpresion.
  insumo        Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  // A qué almacén entró esta línea — opcional (ver comentario de Almacen).
  almacenId     String?
  almacen       Almacen? @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  /// Cuántas unidades de COMPRA se pidieron (ej: 10 packs) — no las que
  /// entran al stock, que son cantidad × rendimiento.
  cantidad      Decimal  @db.Decimal(12, 3)
  /// Snapshot de Insumo.rendimiento al comprar: si el insumo cambia de
  /// presentación después, esta compra ya registrada no se mueve sola.
  rendimiento   Decimal  @default(1) @db.Decimal(12, 3)
  /// Costo de UNA unidad de compra (el precio del pack), neto sin IVA.
  costoUnitario Decimal  @db.Decimal(10, 2)
  /// Descuento propio de esta línea — ej: el proveedor bonifica solo un
  /// insumo puntual, no toda la factura.
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  /// cantidad × costoUnitario, ya con el descuento de línea aplicado (sin
  /// IVA — el IVA se desglosa aparte con el campo `iva` de abajo).
  subtotal      Decimal  @db.Decimal(10, 2)
  // Snapshot del IVA del insumo al momento de la compra — igual que
  // OrderItem.iva/VentaPosItem.iva: si el insumo cambia de tasa después,
  // esta compra ya registrada no se mueve sola.
  iva           String   @default("gravado10")

  @@index([storeId])
  @@index([compraId])
  @@index([insumoId])
  @@index([almacenId])
}

model Gasto {
  id            String     @id @default(cuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  concepto      String
  // Una de las cinco fijas ("alquiler" | "servicios" | "sueldos" | "insumos" |
  // "otros") o el NOMBRE de una categoría propia del local (ver CategoriaGasto) —
  // whitelist
  // en la Server Action, mismo criterio que Product.iva.
  categoria     String     @default("otros")
  monto         Decimal    @db.Decimal(10, 2)
  fecha         DateTime   @default(now())
  proveedorId   String?
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  notas         String?
  registradoPor String?
  createdAt     DateTime   @default(now())

  // --- Datos de la factura del gasto (todos opcionales) ---
  // Muchos gastos no tienen factura, ni RUC, ni razón social de nadie: por eso
  // ninguno se exige. Son los mismos datos que una compra, para poder informar
  // este gasto en el registro de compras de la DNIT (RG 90) más adelante.
  /// Folio de la factura (ej: 001-001-0001234).
  numeroComprobante    String?
  /// Timbrado de esa factura (hasta 8 dígitos).
  timbrado             String?
  /// RUC o cédula de quien emitió la factura, tal como se escribió — sirve
  /// cuando no está cargado como Proveedor.
  proveedorRuc         String?
  proveedorRazonSocial String?
  /// "gravado10" | "gravado5" | "exento": la tasa de IVA del monto.
  iva                  String    @default("gravado10")
  /// "contado" | "credito".
  condicionPago        String    @default("contado")
  /// Solo tiene sentido si es a crédito.
  fechaVencimiento     DateTime?

  @@index([storeId])
  @@index([proveedorId])
}

/// El ledger: cada movimiento de stock, venga de donde venga. Fuente de
/// verdad para el historial de "Registro de inventario" y para poder
/// revertir el descuento de una venta cancelada sin tener que re-derivar
/// nada (no hace falta saber de nuevo qué recetas tenía cada ítem: alcanza
/// con buscar los movimientos "venta" de ese orderId/ventaPosId e invertirlos).
model MovimientoStock {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  insumoId String
  // Restrict, mismo motivo que CompraItem.insumo: el ledger no se toca
  // aunque el insumo se desactive.
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  /// "venta" | "compra" | "ajuste" | "cancelacion" | "correccion" | "movimiento"
  /// ("movimiento": una entrada o salida manual de almacén, con su motivo).
  tipo     String
  /// Con signo: negativo en "venta", positivo en "compra"/"cancelacion";
  /// en "ajuste" es la diferencia (contado - stockActual), puede ser
  /// cualquier signo; en "correccion" (una compra editada después de
  /// guardarse) es la diferencia entre lo que sumó y lo que debió sumar.
  cantidad Decimal @db.Decimal(12, 3)

  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ventaPosId String?
  ventaPos   VentaPos? @relation(fields: [ventaPosId], references: [id], onDelete: SetNull)
  compraId   String?
  compra     Compra?   @relation(fields: [compraId], references: [id], onDelete: SetNull)

  /// En qué almacén entra o de cuál sale este movimiento. Null solo en los
  /// movimientos viejos, de antes de que el stock se repartiera por almacén.
  almacenId String?
  almacen   Almacen? @relation(fields: [almacenId], references: [id], onDelete: SetNull)

  motivo        String?
  registradoPor String?
  createdAt     DateTime @default(now())

  @@index([storeId])
  @@index([insumoId])
  @@index([orderId])
  @@index([ventaPosId])
  @@index([almacenId])
}

/// Una toma de inventario guardada: qué almacén y qué categorías se contaron,
/// cuánto valía el stock según el sistema y cuánto vale con lo contado. Es el
/// registro para poder consultarlo después; lo que cambió en el stock quedó
/// además como movimientos "ajuste" de cada insumo (ver MovimientoStock).
/// El nombre del almacén y las categorías son copias de ese momento: el
/// registro se lee igual aunque después se renombren.
model Inventario {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  almacenId String?
  almacen   Almacen? @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  almacenNombre String
  /// "Bebidas, Carnes" — las categorías que se contaron.
  categorias    String
  /// Cuántos insumos se escribieron como contados (los demás quedaron sin contar).
  contados      Int
  /// De esos, cuántos no coincidían con el sistema.
  conDiferencia Int
  /// Valor del stock según el sistema (a costo de cada insumo).
  valorSistema  Decimal  @db.Decimal(14, 2)
  /// Valor con lo contado; lo que no se contó se toma como estaba.
  valorContado  Decimal  @db.Decimal(14, 2)
  registradoPor String?
  createdAt     DateTime @default(now())

  items InventarioItem[]

  @@index([storeId, createdAt])
}

/// Una fila de la planilla de un inventario, con los datos del insumo tal
/// como estaban al guardar.
model InventarioItem {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventarioId String
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  insumoId     String?
  insumo       Insumo?    @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  insumoNombre    String
  categoriaNombre String?
  unidad          String
  /// Lo que decía el sistema en ese almacén al guardar.
  stockSistema  Decimal  @db.Decimal(12, 3)
  /// Lo que se contó. Null = no se contó este insumo.
  contado       Decimal? @db.Decimal(12, 3)
  /// contado - stockSistema. Null si no se contó.
  diferencia    Decimal? @db.Decimal(12, 3)
  costoUnitario Decimal? @db.Decimal(10, 2)
  /// Posición en la planilla.
  orden         Int      @default(0)

  @@index([storeId])
  @@index([inventarioId])
}

/// Categorías de gasto que creó el local, además de las cinco fijas (ver
/// src/lib/categoria-gasto.ts). Se crean ahí mismo, al cargar un gasto. Un
/// gasto guarda el NOMBRE en Gasto.categoria, así que el nombre no se puede
/// repetir dentro del local (ni llamarse como una de las fijas).
model CategoriaGasto {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  createdAt DateTime @default(now())

  @@unique([storeId, nombre])
}

/// Quien atiende a los clientes en un negocio que trabaja con turnos: el
/// barbero, la peluquera, la manicurista. No es un usuario del panel (no entra
/// al sistema): solo es a quien se le agenda el turno.
model MiembroPersonal {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  apellido  String?
  /// En formato internacional, solo dígitos (ej: 595984123456).
  telefono  String?
  profesion String?
  fotoUrl   String?
  orden     Int      @default(0)
  /// Se desactiva en vez de borrarse: sus turnos viejos siguen mostrándose.
  activo    Boolean  @default(true)
  /// Comisión por trabajo: el porcentaje (0 a 100) de lo que se cobra en cada cita suya.
  /// NULL = no cobra comisión. Cada cita guarda el porcentaje que tenía al cobrarse.
  comisionPorcentaje Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now())

  citas     Cita[]
  servicios ServicioPersonal[]

  @@index([storeId])
}

/// Un turno agendado: un cliente con un miembro del personal, de `inicio` a
/// `fin`. Es lo que se ve en el calendario de la Agenda.
model Cita {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  personalId    String
  personal      MiembroPersonal @relation(fields: [personalId], references: [id])
  clienteNombre String
  /// Instantes reales (UTC): en pantalla se muestran en hora de Asunción.
  inicio        DateTime
  fin           DateTime
  /// pendiente | proxima | finalizada | cancelada | no_asistio (ver src/lib/agenda.ts)
  estado        String          @default("pendiente")
  /// Lo que cuesta el turno. NULL = todavía sin precio.
  precio        Decimal?        @db.Decimal(10, 2)
  /// Datos del cliente cuando el turno lo pidió él desde la página de reservas.
  clienteTelefono String?
  clienteEmail    String?
  nota            String?
  /// Respuestas a los campos extra del formulario: [{ clave, etiqueta, valor }].
  extras          Json?
  /// Los servicios, en una línea, para verlos en el calendario: "Corte Moderno + Barba".
  serviciosTexto  String?
  /// Tiempo de búfer que se reserva después del turno (limpiar, preparar), en minutos.
  bufferMin       Int             @default(0)
  /// panel = lo cargó el negocio; web = lo pidió el cliente desde la página de reservas.
  origen          String          @default("panel")
  /// false = todavía no se ve en el calendario (esperando que el cliente mande el
  /// aviso por WhatsApp). Sigue reservando el horario un rato (ver disponibilidad.ts).
  visible         Boolean         @default(true)
  /// Descuento de la cuenta, en guaraníes (0 = sin descuento), y el porcentaje si se
  /// cargó así. `precio` ya es lo que se cobra, con el descuento restado.
  descuento           Decimal  @default(0) @db.Decimal(10, 2)
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  /// La venta del punto de venta con la que se cobró la cita. Con esto la cita
  /// "entró en caja": pasa a Finalizada y aparece en Citas. Si esa venta se cancela,
  /// se suelta y la cita vuelve a estar sin cobrar.
  ventaPosId      String?         @unique
  ventaPos        VentaPos?       @relation(fields: [ventaPosId], references: [id], onDelete: SetNull)
  /// El porcentaje de comisión de quien atendió, tal como era al cobrar la cita (así
  /// cambiarlo después no mueve lo ya ganado). NULL = todavía no se cobró, o no tenía.
  comisionPorcentaje Decimal? @db.Decimal(5, 2)
  createdAt     DateTime        @default(now())

  servicios CitaServicio[]

  @@index([storeId, inicio])
  @@index([personalId])
}

/// Cada servicio de un turno, con su nombre, duración y precio tal como eran al
/// reservar (así el turno no cambia si después se edita el servicio).
model CitaServicio {
  id         String          @id @default(cuid())
  storeId    String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  citaId     String
  cita       Cita            @relation(fields: [citaId], references: [id], onDelete: Cascade)
  servicioId String?
  servicio   ServicioAgenda? @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  nombre     String
  duracionMin Int
  precio     Decimal         @db.Decimal(10, 2)

  @@index([storeId])
  @@index([citaId])
}

/// El horario general de trabajo del negocio para la Reserva de turnos: una fila
/// por día de la semana, con si se trabaja ese día, de qué hora a qué hora y el
/// descanso del medio (el almuerzo). Se guardan siempre los siete días juntos.
model HorarioTrabajo {
  id             String  @id @default(cuid())
  storeId        String
  store          Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// 0 = domingo, 1 = lunes ... 6 = sábado (mismo criterio que HorarioAtencion).
  diaSemana      Int
  /// Apagado: ese día el negocio no atiende.
  trabaja        Boolean @default(true)
  /// "HH:MM"
  inicio         String  @default("09:00")
  fin            String  @default("18:00")
  descansa       Boolean @default(false)
  descansoInicio String  @default("13:00")
  descansoFin    String  @default("14:00")

  @@unique([storeId, diaSemana])
  @@index([storeId])
}

/// Lo propio de la agenda de un servicio: cuánto dura, el tiempo de búfer, su
/// color y quién lo realiza. El servicio en sí (nombre, categoría, precio, IVA)
/// es un Product con esServicio = true: así se vende en el punto de venta y se
/// factura (incluida la factura electrónica, "prestación de servicios") sin
/// duplicar nada.
model ServicioAgenda {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Cuánto dura el servicio, en minutos.
  duracionMin Int
  /// Tiempo de búfer después del servicio (limpiar, preparar), en minutos. 0 = sin búfer.
  bufferMin   Int      @default(0)
  /// fijo | desde: si el monto es exacto o "desde" tanto (ver src/lib/servicios-agenda.ts).
  tipoPrecio  String   @default("fijo")
  /// Color del servicio en la agenda, "#RRGGBB".
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())

  personal      ServicioPersonal[]
  citaServicios CitaServicio[]

  @@index([storeId])
}

/// Qué miembros del personal realizan un servicio.
model ServicioPersonal {
  id         String          @id @default(cuid())
  storeId    String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  servicioId String
  servicio   ServicioAgenda  @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  personalId String
  personal   MiembroPersonal @relation(fields: [personalId], references: [id], onDelete: Cascade)

  @@unique([servicioId, personalId])
  @@index([storeId])
  @@index([personalId])
}

/// La página pública de reservas de un negocio de turnos (salón, barbería…).
/// Es aparte de la configuración base del negocio (Store): tiene su propio
/// nombre, dirección web, contacto, redes, galería y apariencia. Una por local.
model PaginaReservas {
  id      String  @id @default(cuid())
  storeId String  @unique
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// La dirección pública: /turnos/<slug>. Única entre todos los negocios.
  slug    String  @unique
  /// Interruptor "Habilitar la reserva en línea": apagada, la página no se ve.
  habilitada Boolean @default(false)
  nombre  String
  /// El rubro que se muestra debajo del nombre ("Barbershop", "Salón de belleza").
  industria   String?
  descripcion String?
  email       String?
  /// Internacional, solo dígitos (ej: 595984123456).
  telefono    String?
  fotoUrl     String?
  bannerUrl   String?
  /// Enlaces completos (https://…).
  instagram String?
  tiktok    String?
  facebook  String?
  /// El número donde llegan las reservas, internacional y solo dígitos.
  whatsapp      String?
  /// Si el cliente, al reservar, manda el aviso por WhatsApp a ese número.
  avisoWhatsapp Boolean @default(true)
  /// Cuándo entra la reserva al calendario: al_reservar | al_enviar_whatsapp.
  entradaCalendario String @default("al_reservar")
  /// Hasta 5 fotos: [{ "url": "https://…", "descripcion": "…" }].
  galeria Json @default("[]")
  /// El color de la página, "#RRGGBB".
  colorPrimario String @default("#3B82F6")
  /// claro | oscuro | sistema.
  tema    String @default("claro")
  /// Los campos del formulario de reserva y cuáles son obligatorios
  /// (ver src/lib/pagina-reservas.ts).
  campos  Json   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
