// Esquema de base de datos — multi-local.
//
// Cada fila de negocio (Store) es un local, y TODAS las tablas de datos
// cuelgan de una a través de `storeId`. Esa columna es lo que separa a un
// negocio de otro: si una consulta se olvida de filtrarla, un local vería
// los datos de otro. Por eso no se filtra a mano en cada consulta, sino
// que se usa el acceso de src/lib/prisma-local.ts, que la inyecta solo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id             String   @id @default(cuid())
  // Nombre en la URL pública: tumenusmart.app/lafogata
  slug           String   @unique
  nombre         String
  whatsappNumero String // formato internacional sin '+', ej: 595981234567
  logoUrl        String?
  // Color de marca del local (hex, ej "#2E7D32") para el menú público — el
  // panel admin sigue siempre naranja, esto es solo lo que ve el cliente del
  // restaurante. Sin valor, el menú público usa el mismo naranja de siempre.
  colorPrimario  String?
  direccion      String?
  mensajeSaludo  String? // texto opcional al inicio del mensaje de WhatsApp (pedidos)
  mensajeSaludoReserva String? // texto opcional al inicio del mensaje de WhatsApp (reservas)
  lat            Float? // ubicación del local, centro para calcular distancias de envío
  lng            Float?
  envioModo      String   @default("zonas") // "zonas" (radio + precio automático) | "coordinar" (el negocio lo define directo con el cliente)

  // --- Formas de pago y de entrega ---
  // Qué opciones ve el cliente en el checkout público. Todas arrancan en true
  // para que los locales existentes sigan viendo las mismas 6 opciones de
  // siempre hasta que el dueño entre a Configuración y destilde alguna.
  aceptaEfectivo       Boolean @default(true)
  aceptaTransferencia  Boolean @default(true)
  aceptaTarjetaDebito  Boolean @default(true)
  aceptaTarjetaCredito Boolean @default(true)
  aceptaDelivery       Boolean @default(true)
  aceptaRetiro         Boolean @default(true)
  aceptaMesa           Boolean @default(true)

  // Si este local reserva mesas con anticipación. Es OTRA cosa que
  // "aceptaMesa" de arriba (ese es "comer en el local" al hacer un pedido
  // ahora); esto es el botón "Reservar mesa" del menú público, para locales
  // que solo hacen delivery/retiro y no tienen mesas físicas que reservar.
  aceptaReservas Boolean @default(true)

  /// Cómo se ve la carta pública de este local.
  ///
  /// "lista"    — filas compactas con miniatura. Es lo mejor para el local que
  ///              saca las fotos con el celular: la foto chica disimula.
  /// "tarjetas" — foto grande arriba de cada producto. Para el local que tiene
  ///              fotos profesionales, donde la foto es lo que vende.
  ///
  /// Forzar un solo diseño castiga a uno de los dos.
  estiloCarta    String   @default("lista")
  // Corte manual: el encargado apaga los pedidos aunque esté dentro del
  // horario (cocina saturada, falta de personal, etc.).
  pedidosPausados Boolean @default(false)
  mensajePausa    String? // motivo opcional que ve el cliente al entrar

  // Política a nivel LOCAL (no de un punto de expedición puntual): si el
  // timbrado Autoimpresor de este negocio exige facturar TODA venta (RG
  // 90/2021 SET/DNIT), el dueño lo prende acá. Prendido: el POS deja de
  // ofrecer "Ticket" y el checkout público sigue mostrando las mismas dos
  // opciones de siempre, pero "Ticket" se guarda igual como factura a
  // Consumidor Final. Default false: comportamiento actual, sin cambios.
  facturaObligatoria Boolean @default(false)

  // --- Fidelización ---
  // Cada N pedidos ENTREGADOS del mismo cliente suman uno para un premio.
  // Sin niveles ni puntos: un umbral y un premio en texto libre.
  fidelizacionActiva Boolean @default(false)
  fidelizacionUmbral Int     @default(10)
  fidelizacionPremio String?
  // Opcional: un pedido solo suma si su total llega a este monto. Nulo =
  // sin mínimo, cualquier pedido entregado suma (comportamiento de antes).
  // Existe para que pedidos muy baratos no le "regalen" el sello al cliente.
  fidelizacionMontoMinimo Int?

  // --- Suscripción ---
  // "activo" atiende con normalidad. "prueba" es igual que activo, sirve
  // para saber que todavía no pagó nunca. "suspendido" y "vencido" apagan
  // el menú público (ver estaSuspendido) pero conservan todo — son la
  // MISMA acción por dos causas distintas: "suspendido" lo apagaste vos a
  // mano (alternarSuspension); "vencido" lo apagó solo el cron diario por
  // falta de pago (suspender-vencidos). Separados para que el panel de
  // cartera pueda avisarte de uno y no del otro — antes compartían el mismo
  // valor y un cliente vencido se veía igual que uno que vos apagaste.
  estado         String    @default("activo")
  vencimiento    DateTime?
  plan           String    @default("basico")

  // Quién de tu equipo comercial trajo o atiende este cliente. Se asigna al
  // dar de alta el local (o después, a mano) — nunca lo elige ni lo ve el
  // dueño del local, es solo para tu propia cartera.
  asesorId       String?
  asesor         Asesor?   @relation(fields: [asesorId], references: [id])

  // --- Datos del titular ---
  // Para uso interno de TuMenuSmart (facturación, contacto directo con el
  // dueño real) — no lo ve el cliente ni el propio local en su panel. Los
  // cuatro son opcionales: se cargan si se tienen a mano al dar de alta, o
  // se completan/editan después desde Cartera.
  titularNombre   String?
  titularTelefono String?
  razonSocial     String?
  ruc             String?

  // --- Numeración propia de cada local ---
  // Así cada negocio ve sus pedidos desde el #0001 en vez de heredar un
  // contador global compartido con el resto. Se incrementan de a uno en
  // la misma transacción que crea el pedido o la reserva.
  contadorPedidos  Int @default(0)
  contadorReservas Int @default(0)
  contadorVentasPos Int @default(0)
  // Igual que los anteriores, para la Clave de Customer.numero.
  contadorClientes Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categorias     Category[]
  productos      Product[]
  opciones       ProductOption[]
  zonas          DeliveryZone[]
  clientes       Customer[]
  repartidores   Repartidor[]
  pedidos        Order[]
  itemsPedido    OrderItem[]
  reservas       Reservation[]
  horariosReserva  HorarioReserva[]
  horariosAtencion HorarioAtencion[]
  horariosCategoria CategoriaHorario[]
  usuarios         Usuario[]
  ideasSemanales   IdeaSemanal[]
  pagos            Pago[]
  urlsAnteriores   SlugAnterior[]
  rendiciones      Rendicion[]
  turnosPos        TurnoPos[]
  ventasPos        VentaPos[]
  ventaPosItems    VentaPosItem[]
  estaciones       Estacion[]
  puntosExpedicion PuntoExpedicion[]
  areasImpresion   AreaImpresion[]
  estacionesImpresoras EstacionImpresora[]
}

/// Las direcciones que este local tuvo antes.
///
/// Cuando un negocio cambia su URL, los carteles con QR ya impresos, los
/// enlaces compartidos por WhatsApp y lo que Google tenga indexado siguen
/// apuntando a la vieja. Sin esto, todo eso muere el día del cambio.
///
/// Guardando la anterior, la carta redirige sola a la nueva y nadie se entera.
model SlugAnterior {
  id      String   @id @default(cuid())
  slug    String   @unique
  storeId String
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creadoEn DateTime @default(now())

  @@index([storeId])
}

/// Cada problema técnico que ocurrió en producción.
///
/// No es un registro de todo: los errores se AGRUPAN por su huella, así que
/// una fila es "un problema", no "una vez que falló". Si el mismo bug ocurre
/// doscientas veces, es una fila con ocurrencias = 200.
///
/// Esa distinción es la que hace que la pantalla sea legible: una lista de
/// doscientas líneas iguales no se mira, una de tres problemas sí.
model ErrorReportado {
  id String @id @default(cuid())

  /// Qué problema es. Sale de huellaDeError(): mismo bug con ids distintos
  /// cae en la misma huella.
  huella String @unique

  /// De qué local. Nulo cuando el error ocurrió fuera del contexto de uno
  /// (la portada, el login, un cron).
  storeId     String?
  nombreLocal String?

  ruta    String
  mensaje String
  /// El rastro completo, recortado. Es lo que se lee para entender la causa.
  detalle String?
  /// Qué usuario lo sufrió, si había sesión.
  usuario String?

  ocurrencias Int      @default(1)
  primeraVez  DateTime @default(now())
  ultimaVez   DateTime @default(now())

  /// Cuándo se mandó el último correo por este problema. Nulo = nunca se avisó.
  avisadoEn DateTime?
  /// Marcado como resuelto a mano desde el panel. No se borra: si vuelve a
  /// ocurrir se desmarca solo y vuelve a avisar.
  resuelto Boolean @default(false)

  @@index([resuelto, ultimaVez])
  @@index([storeId])
}

/// Cada pago recibido de un local.
///
/// Se guarda el historial completo y no solo el vencimiento vigente: cuando un
/// cliente pregunta "yo te pagué en mayo", la respuesta tiene que estar en el
/// sistema y no en la memoria de nadie.
model Pago {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// En guaraníes. Se guarda lo que efectivamente entró.
  monto  Decimal  @db.Decimal(12, 2)
  /// Cuándo se recibió el pago.
  fecha  DateTime @default(now())
  /// Hasta qué día queda cubierto el local con este pago.
  cubreHasta DateTime
  /// Cuántos meses se cobraron, para poder reconstruir el criterio.
  meses  Int      @default(1)
  /// Número de transferencia, o cualquier cosa que sirva para encontrarlo.
  nota   String?

  /// Quién lo registró. Se guarda el correo y no el id: si algún día se borra
  /// ese usuario, el historial de cobranza igual sigue diciendo quién fue.
  registradoPor String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeId, fecha])
}

/// Un vendedor/asesor comercial de TuMenuSmart (no de un local puntual —
/// esto es tuyo, de la plataforma). No cuelga de ningún Store por storeId
/// como el resto de las tablas: es al revés, son los Store los que apuntan
/// acá para decir quién los trajo.
model Asesor {
  id       String  @id @default(cuid())
  nombre   String
  telefono String
  ciudad   String
  email    String

  /// Un asesor que ya no trabaja más no se borra (perdería la referencia en
  /// los locales que trajo) — se lo marca inactivo y desaparece de la lista
  /// para asignar en locales nuevos, sin tocar los que ya tiene.
  activo Boolean @default(true)

  createdAt DateTime @default(now())

  locales Store[]
}

/// La idea que se le pone adelante al dueño cada semana.
///
/// La pantalla de Ideas calcula todo en vivo cada vez que se abre, pero eso
/// sirve para hurgar, no para actuar. Una vez por semana se elige UNA sola y
/// se guarda acá, por tres motivos: que no cambie de un rato a otro dentro de
/// la misma semana, poder saber si el dueño ya la vio, y no repetirle lo
/// mismo varios lunes seguidos.
model IdeaSemanal {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Lunes de la semana, en formato AAAA-MM-DD y en hora de Asunción.
  /// Es texto y no fecha a propósito: identifica la semana sin que el huso
  /// horario pueda correrla un día para atrás o para adelante.
  semana String

  /// Cuál de los análisis quedó elegido, para no repetirlo la semana próxima.
  clave     String
  tipo      String
  titulo    String
  dato      String
  accion    String
  confianza String
  /// Filas de apoyo, guardadas como JSON en texto.
  detalle   String?

  /// Cuándo la vio el dueño. Mientras esté vacío, el panel muestra el aviso.
  vistaEn   DateTime?
  createdAt DateTime  @default(now())

  @@unique([storeId, semana])
  @@index([storeId])
}

/// Quién puede entrar al panel.
///
/// OJO: este modelo NO entra en el filtro automático por local, y es a
/// propósito. El ingreso ocurre antes de saber de qué local se trata —
/// justamente lo averiguamos leyendo esta tabla— así que filtrarlo por
/// local haría imposible iniciar sesión. Cada consulta de acá decide
/// explícitamente su alcance.
model Usuario {
  id           String  @id @default(cuid())
  email        String  @unique
  // Formato "scrypt:sal:hash". Nunca se guarda la contraseña en claro.
  passwordHash String
  nombre       String?

  /// "superadmin" ve todos los locales y administra usuarios.
  /// "local" queda atado a su negocio y no sabe que existen otros.
  /// Es texto y no enum para poder sumar "empleado" sin migrar la base.
  rol     String  @default("local")
  /// Nulo solamente para el superadmin, que no pertenece a ningún local.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  activo Boolean @default(true)

  /// Queda en true cuando la contraseña la generó el sistema o la restableció
  /// un administrador. Mientras esté así, el panel le insiste al usuario que
  /// la cambie: una contraseña que pasó por WhatsApp la vio más de una persona.
  debeCambiarPassword Boolean @default(false)

  // --- Freno a la fuerza bruta ---
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  ultimoIngreso    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// Horario de atención del local, un registro por tramo. Un día SIN
// registros = cerrado ese día (ej: cierra los lunes). Dos registros el
// mismo día = turno partido (ej: 11:00-14:00 y 18:00-23:30).
model HorarioAtencion {
  id        String @id @default(cuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  diaSemana Int // 0 = domingo, 1 = lunes ... 6 = sábado
  abre      String // "HH:MM"
  cierra    String // "HH:MM" — si es menor que `abre`, el cierre cae pasada la medianoche
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int       @default(0)
  // Si está en false, la categoría (y sus productos) no aparecen en el
  // menú público, pero se conservan en el admin — útil para promos de un
  // día sin tener que borrar nada.
  activa    Boolean   @default(true)
  productos Product[]
  createdAt DateTime  @default(now())
  // Días y horarios en que esta categoría se OCULTA de la carta pública —
  // ej: "Hamburguesas Simple" no se vende lunes ni martes. Es al revés del
  // horario de atención del local: sin tramos cargados, la categoría se
  // muestra SIEMPRE (default), y los tramos cargados son ventanas de
  // bloqueo puntuales, no un horario completo que haya que definir.
  horarios  CategoriaHorario[]

  @@index([storeId])
}

// Mismo shape que HorarioAtencion (día + abre + cierra), pero el criterio es
// el opuesto: acá el tramo dice cuándo se OCULTA la categoría, no cuándo
// atiende el local. Reutiliza el cálculo de "¿estamos dentro de alguno de
// estos tramos ahora?" (`calcularEstadoAtencion`, genérica) a través de
// `categoriaOcultaPorHorario` en horario-atencion.ts, que es la que invierte
// el resultado. Dos categorías pueden tener bloqueos muy distintos entre sí
// (ej: "Hamburguesas Simple" lunes y martes, "Postres" ninguno).
model CategoriaHorario {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  diaSemana  Int // 0=domingo … 6=sábado, mismo criterio que HorarioAtencion
  abre       String // "HH:MM"
  cierra     String // "HH:MM"

  @@index([storeId])
  @@index([categoryId])
}

model Product {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  // A qué Área de Impresión (Cocina, Barra, Caja...) se manda este producto
  // en la comanda automática — ver AreaImpresion. Null = no imprime en
  // ninguna comanda automática (comportamiento esperado, no un error; el
  // producto se sigue viendo en la comanda completa manual).
  areaImpresionId String?
  areaImpresion   AreaImpresion? @relation(fields: [areaImpresionId], references: [id], onDelete: SetNull)
  nombre      String
  descripcion String?
  precio      Decimal         @db.Decimal(10, 2)
  /// Lo que le cuesta al negocio preparar este producto. Opcional: mientras
  /// esté vacío, el analista comercial habla de facturación pero no de
  /// margen, en vez de inventarlo.
  costo       Decimal?        @db.Decimal(10, 2)
  // "gravado10" | "gravado5" | "exento" — string simple con whitelist en la
  // Server Action, no enum de Prisma (mismo criterio que mitadYMitadModo).
  // Todavía no lo consume ningún cálculo: es la base para el desglose de
  // IVA de la futura Factura Autoimpresor.
  iva         String          @default("gravado10")
  imagenUrl   String?
  disponible  Boolean         @default(true)
  orden       Int             @default(0)
  // Ingredientes "de base" del producto, mostrados como etiquetas que el
  // cliente puede sacar (no agregar) al pedir — ej: ["tomate", "cebolla"].
  ingredientes String[]       @default([])
  // "Mitad y mitad": si tiene un grupo cargado, este producto se puede
  // combinar con cualquier otro producto que tenga EXACTAMENTE el mismo
  // texto de grupo (ej: "Pizza Grande") — así conviven en el mismo menú
  // productos de distinto tamaño sin mezclarse entre sí. Vacío = no aplica.
  mitadYMitadGrupo String?
  // "mayor": cobra el precio del más caro de los dos. "proporcional": la
  // mitad de cada uno, sumadas. Debería ser el mismo valor en todos los
  // productos de un mismo grupo.
  mitadYMitadModo  String          @default("mayor")
  // Si está marcado, aparece en el carrusel de destacados del menú público.
  destacado   Boolean         @default(false)
  opciones    ProductOption[]
  orderItems  OrderItem[]
  ventaPosItems VentaPosItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([storeId])
  @@index([categoryId])
}

// Cubre tanto variantes (tamaño, sabor — normalmente eliges una)
// como agregados (extras — normalmente eliges varios).
model ProductOption {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nombre      String
  tipo        String // "variante" | "agregado"
  precioExtra Decimal @db.Decimal(10, 2) @default(0)
  /// Lo que le cuesta al negocio esta variante o agregado extra (ej: la
  /// papa frita que se agrega a una hamburguesa). Opcional, mismo criterio
  /// que Product.costo: mientras esté vacío, el reporte de rentabilidad no
  /// puede calcular el margen real de lo que se vendió CON este agregado —
  /// antes esa plata quedaba contada como ganancia del producto principal,
  /// inflando su margen cada vez que se vendía con algo pago encima.
  costo       Decimal? @db.Decimal(10, 2)
  orden       Int     @default(0)

  @@index([storeId])
  @@index([productId])
}

// Solo se usa cuando Store.envioModo = "zonas". Cada zona es un anillo de
// distancia desde el local: "hasta radioKm kilómetros, cuesta costoEnvio".
// Se evalúan ordenadas de menor a mayor radio; la primera que alcanza la
// distancia del cliente es la que se aplica.
model DeliveryZone {
  id         String  @id @default(cuid())
  storeId    String
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre     String // etiqueta libre, ej: "Zona 1" o "Centro"
  radioKm    Decimal @db.Decimal(6, 2)
  costoEnvio Decimal @db.Decimal(10, 2)
  activo     Boolean @default(true)
  orders     Order[]

  @@index([storeId])
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  // Opcional: un cliente que se da de alta solo por facturar (Fase 5 de
  // Factura Autoimpresor, ver identificación fiscal más abajo) puede no
  // dar el teléfono — eso no le impide facturar, solo lo deja afuera de la
  // fidelización por teléfono.
  telefono  String?
  orders    Order[]
  createdAt DateTime @default(now())

  // Pedidos entregados de este cliente ya "gastados" en un premio anterior.
  // No se resetea el conteo de pedidos entregados: se SUMA el umbral acá
  // cada vez que se entrega un premio, para no perder los pedidos de más
  // que hizo antes de que alguien marcara el canje.
  pedidosCanjeados Int @default(0)

  // Identificación fiscal (RUC/Cédula/Pasaporte/etc. — ver
  // src/lib/tipo-cliente.ts) para la Factura Autoimpresor del POS. Se carga
  // la primera vez que el cliente factura con registro fiscal y queda para
  // las próximas visitas. Null en los clientes que solo existen por
  // fidelización y nunca facturaron.
  tipoIdentificacion   String?
  numeroIdentificacion String?

  // Clave secuencial visible del cliente — nullable y SIN backfill (mismo
  // criterio que tipoIdentificacion/numeroIdentificacion): los clientes ya
  // cargados se quedan sin clave, no amerita un script de datos. Sale de
  // Store.contadorClientes vía siguienteNumeroCliente(), y solo se asigna
  // en el momento en que el Customer se crea de verdad (nunca en un update
  // — evita gastar una clave nueva cada vez que un cliente que ya existe
  // vuelve a facturar, que es el caso más común, no el raro).
  numero Int?
  // Pensado para el día que se implemente la factura electrónica — no se
  // usa para enviar nada todavía.
  email  String?

  // El mismo número puede ser cliente de dos locales distintos: son
  // personas distintas para cada negocio. Postgres no choca dos NULL entre
  // sí, así que un cliente sin teléfono, otro sin identificación fiscal y
  // otro sin clave conviven sin problema con estos índices.
  @@unique([storeId, telefono])
  @@unique([storeId, tipoIdentificacion, numeroIdentificacion])
  @@unique([storeId, numero])
  @@index([storeId])
}

model Repartidor {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  telefono  String?
  activo    Boolean  @default(true)
  orders    Order[]
  rendiciones Rendicion[]
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Order {
  id                   String        @id @default(cuid())
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Número correlativo para mostrarle al cliente y al encargado — el id
  // (cuid) sigue siendo la clave interna/URLs, pero un código con letras y
  // números confunde al cliente al leerlo por teléfono.
  // Número que ve el cliente. Sale de `contadorPedidos` del local, así cada
  // negocio lleva su propia numeración desde el #0001.
  //
  // A propósito NO tiene valor por defecto: si alguna consulta se olvidara de
  // pedirle el número al local, no compila. Y si igual llegara a la base, la
  // base la rechaza. Un número equivocado sería visible para el cliente.
  numero               Int
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  clienteNombre        String
  clienteTelefono      String
  estado               String        @default("pendiente") // pendiente | confirmado | en_preparacion | en_despacho | entregado | cancelado
  tipoEntrega          String // "delivery" | "retiro" | "mesa"
  deliveryZoneId       String?
  deliveryZone         DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  repartidorId         String? // solo aplica a pedidos "delivery" en camino
  repartidor           Repartidor?   @relation(fields: [repartidorId], references: [id])
  direccion            String?
  // Solo para tipoEntrega "mesa": el número/nombre que el cliente escribió
  // para identificar dónde está sentado. Null en delivery/retiro.
  mesaNumero           String?
  clienteLat           Float? // pin que marcó el cliente en el mapa al hacer el pedido
  clienteLng           Float?
  metodoPagoReferencia String // "efectivo" | "transferencia" | "tarjeta" | "otro" — solo informativo, no se procesa

  /// Lo que el repartidor DE VERDAD cobró al entregar.
  ///
  /// No es lo mismo que metodoPagoReferencia: ese es lo que el cliente dijo
  /// que iba a pagar cuando armó el pedido. En la puerta cambia todo el
  /// tiempo — dijo efectivo y sacó la tarjeta, o al revés. Para cuadrar la
  /// caja del repartidor sirve lo que pasó, no lo que se pensaba hacer.
  ///
  /// null mientras el pedido no esté entregado.
  cobroMetodo          String? // "efectivo" | "tarjeta" | "transferencia" | "ya_pagado"
  entregadoEn          DateTime?

  /// A qué cierre de caja pertenece. null = todavía no lo rindió.
  rendicionId          String?
  rendicion            Rendicion? @relation(fields: [rendicionId], references: [id])

  /// Solo para retiro/mesa (nunca delivery, que sigue yendo por
  /// rendicionId/cobroMetodo): forma de pago declarada al marcar el pedido
  /// "entregado", y a qué turno de caja del Punto de Venta quedó atado —
  /// mismos 4 valores y mismo cierre que una venta de mostrador, sin un
  /// segundo paso de caja aparte. Null si no había un turno abierto en ese
  /// momento (el pedido queda entregado igual, simplemente no entra en
  /// ningún cierre).
  formaPagoPos         String?
  turnoPosId           String?
  turnoPos             TurnoPos?     @relation(fields: [turnoPosId], references: [id])

  comprobanteTipo      String        @default("ticket") // "ticket" | "factura"
  facturaRazonSocial   String?
  facturaRuc           String?
  // Clasificación fiscal SET del comprador (Tabla 3, RG 90/2021) — "ruc" |
  // "sin_nombre" | etc. (ver src/lib/tipo-cliente.ts). Null en pedidos de
  // antes de esta fase, donde solo se guardaba razón social/RUC a secas.
  facturaTipoIdentificacion String?
  facturaEmail         String?

  // Fiscales — se completan y se CONGELAN solo cuando se emite como
  // factura de verdad (retiro/mesa al marcar "entregado", delivery al
  // pasar a "en_despacho" — ver cambiarEstadoPedido en pedidos/actions.ts).
  // A diferencia de VentaPos (que lee el emisor en vivo vía
  // turnoPos.estacion.puntoExpedicion porque una venta de mostrador SIEMPRE
  // tiene turno), acá también se congela razonSocialEmisor/rucEmisor: un
  // pedido de delivery nunca tiene turno, así que no hay otra forma de
  // rastrear después qué punto de expedición lo emitió.
  facturaNumero            String?
  facturaTimbrado          String?
  facturaVencimiento       DateTime?
  facturaGravado10         Decimal?  @db.Decimal(10, 2)
  facturaGravado5          Decimal?  @db.Decimal(10, 2)
  facturaExento            Decimal?  @db.Decimal(10, 2)
  facturaIva10             Decimal?  @db.Decimal(10, 2)
  facturaIva5              Decimal?  @db.Decimal(10, 2)
  facturaRazonSocialEmisor String?
  facturaRucEmisor         String?

  notas                String?

  // Auditoría de cancelación — mismos campos y mismo criterio que
  // VentaPos: no se borra la fila, queda quién y por qué. A diferencia de
  // VentaPos (que tiene un booleano `cancelada` aparte), acá "cancelado" ya
  // es uno de los valores posibles de `estado`.
  canceladaPor      String?
  canceladaEn       DateTime?
  motivoCancelacion String?

  // Anular SOLO la factura, sin cancelar el pedido — independiente de
  // "cancelado" de arriba. Existe para el caso de una factura mal cargada
  // (RUC equivocado, razón social mal escrita): se anula el número, pero el
  // pedido en sí sigue siendo una venta real, entregada y cobrada. Cancelar
  // el pedido entero SIGUE anulando la factura de yapa (ver
  // cambiarEstadoPedido) — lo que cambia acá es que ahora también se puede
  // anular la factura SIN tocar el pedido. Los campos facturaNumero/
  // facturaRazonSocial/etc. de arriba NUNCA se pisan ni se limpian: quedan
  // como el registro histórico de qué decía ese número antes de anularse.
  facturaAnulada         Boolean   @default(false)
  facturaAnuladaPor      String?
  facturaAnuladaEn       DateTime?
  facturaMotivoAnulacion String?

  // El pedido se guarda ANTES de que el cliente apriete "Enviar por
  // WhatsApp". Esta marca distingue los pedidos realmente enviados de los
  // que el cliente armó y abandonó en el último paso.
  enviadoWhatsapp      Boolean       @default(false)
  subtotal             Decimal       @db.Decimal(10, 2)
  costoEnvio           Decimal       @db.Decimal(10, 2) @default(0)
  total                Decimal       @db.Decimal(10, 2)
  items                OrderItem[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([rendicionId])
  @@index([turnoPosId])
  @@unique([storeId, numero])
  @@index([storeId])
  @@index([storeId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  // Se repite el local acá (aunque se podría deducir del pedido) para que
  // el filtro automático funcione igual en todas las tablas, sin excepciones
  // que haya que recordar.
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nulo cuando el ítem es un combo "mitad y mitad" (no corresponde a un
  // único producto) — el detalle queda igual en nombreProducto.
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  nombreProducto String // snapshot: el nombre al momento del pedido
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  // Snapshot de la tasa de IVA al momento del pedido — igual que
  // VentaPosItem.iva: si el producto cambia de tasa después, las facturas
  // viejas no se mueven solas.
  iva            String  @default("gravado10")
  opcionesTexto  String? // snapshot de las opciones elegidas, en texto legible
  ingredientesQuitadosTexto String? // snapshot de ingredientes que el cliente sacó, ej: "tomate, cebolla"
  /// Snapshot de cuánto costaban (sumados) los agregados/variantes elegidos
  /// en ESTE ítem, al momento de la venta — a diferencia de Product.costo
  /// (que el reporte de rentabilidad lee siempre ACTUAL, no del día que se
  /// vendió), esto no se puede recalcular después: el pedido no guarda a
  /// cuáles opciones concretas corresponde `opcionesTexto`, solo el texto.
  /// 0 si no se eligió ningún agregado. Null si se eligió alguno pero no
  /// tenía costo cargado en ese momento — "desconocido", nunca inventado.
  /// El default en 0 es solo para los pedidos VIEJOS, de antes de que este
  /// campo existiera: siguen reportando exactamente el mismo número que
  /// hoy (no se vuelven "desconocidos" de golpe). Los pedidos nuevos
  /// siempre mandan un valor explícito desde el checkout, nunca dependen
  /// de este default.
  costoAgregados Decimal? @db.Decimal(10, 2) @default(0)
  /// Snapshot de cuánto de `precioUnitario` corresponde a agregados
  /// (nunca desconocido: a diferencia del costo, el precio de un agregado
  /// no es opcional, siempre está cargado). Existe para que el reporte de
  /// Rentabilidad pueda mostrar el precio de venta del PRODUCTO solo,
  /// siempre el mismo, sin que varíe según si esa venta puntual llevó
  /// agregados o no — antes esos Gs. de más quedaban mezclados en el
  /// precio del producto y lo mostraban como si vendiera más caro.
  precioAgregados Decimal @db.Decimal(10, 2) @default(0)

  @@index([storeId])
  @@index([orderId])
}

// Horarios disponibles para reservar, agrupados por turno. Se configuran
// desde el panel (Reservas → Horarios) y son los que ve el cliente en el
// formulario público de reservas.
model HorarioReserva {
  id     String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  turno  String // "dia" | "tarde" | "noche"
  hora   String // "HH:MM", ej: "12:30"
  activo Boolean @default(true)
  orden  Int     @default(0)
  // Cuántas personas como máximo se pueden sentar en este horario.
  // NULL = sin límite (comportamiento anterior, sigue siendo el default).
  capacidadPersonas Int?

  @@unique([storeId, turno, hora])
  @@index([storeId])
}

model Reservation {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Mismo criterio que Order.numero: sale de `contadorReservas` del local y
  // deliberadamente no tiene valor por defecto.
  numero          Int
  fecha           DateTime // solo día, medianoche Asunción — la mesa/fecha reservada
  turno           String // "dia" | "tarde" | "noche"
  horario         String // "HH:MM" elegido dentro del turno
  personas        Int
  motivo          String // "cumple" | "cita" | "reunion" | "aniversario" | "otro"
  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?
  estado          String   @default("pendiente") // pendiente | confirmada | cancelada
  // Nota interna del encargado — ej: "pidió globos y velitas", cargada
  // después de llamar al cliente para confirmar. No la ve el cliente.
  nota            String?
  // La reserva se guarda ANTES de que el cliente apriete "Enviar por
  // WhatsApp". Hasta que no lo aprieta, no se muestra en el calendario:
  // es una reserva que el cliente armó pero nunca llegó a pedir.
  enviadoWhatsapp Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([storeId, numero])
  @@index([storeId])
  @@index([storeId, fecha])
}

/// El cierre de caja de un repartidor.
///
/// Cuando vuelve al local, el dueño mira cuánto EFECTIVO junta entre sus
/// entregas, lo recibe, y esa vuelta queda cerrada. Los pedidos que entraron
/// en el cierre quedan atados acá y no vuelven a aparecer como pendientes.
///
/// Los totales se copian en vez de calcularse después a propósito: si mañana
/// se corrige el precio de un pedido viejo, la rendición que ya se firmó no
/// puede cambiar sola. Lo que se recibió, se recibió.
model Rendicion {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  repartidorId String
  repartidor   Repartidor @relation(fields: [repartidorId], references: [id])

  /// Cuántos pedidos entraron y cuánta plata de cada tipo, congelados.
  cantidadPedidos Int
  totalEfectivo   Decimal @db.Decimal(10, 2)
  totalOtros      Decimal @db.Decimal(10, 2)

  /// Quién lo recibió, para que después se sepa a quién preguntarle.
  recibidoPor  String
  notas        String?
  creadoEn     DateTime @default(now())

  pedidos      Order[]

  // A qué turno de caja queda atada — el mismo criterio que Order.turnoPosId
  // para retiro/mesa: se pega sola al turno abierto en la estación desde
  // donde se recibió, para que el cierre general del turno pueda sumarla.
  // Sin estación/turno vinculado (un local que no usa Punto de Venta) queda
  // en null, exactamente como funcionaba antes de esto.
  turnoPosId String?
  turnoPos   TurnoPos? @relation(fields: [turnoPosId], references: [id])

  @@index([storeId])
  @@index([repartidorId])
  @@index([turnoPosId])
}

/// El turno de caja del Punto de Venta (mostrador).
///
/// A diferencia de Rendicion (que se calcula sobre pedidos de delivery ya
/// entregados), acá el turno tiene apertura y cierre EXPLÍCITOS: el cajero
/// abre declarando el vuelto inicial, vende, y al cerrar declara cuánto tiene
/// en cada una de las 4 formas de pago. Un solo turno puede estar "abierto"
/// por ESTACIÓN a la vez (ver el índice único parcial en la migración SQL) —
/// dos estaciones del mismo local pueden tener cada una su propio turno
/// abierto en simultáneo, sin pisarse.
///
/// Los "calculado*" y "declarado*" quedan congelados al cerrar, mismo
/// criterio que Rendicion: si después se corrige algo, el cierre ya firmado
/// no se mueve solo.
model TurnoPos {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  estacionId String
  estacion   Estacion @relation(fields: [estacionId], references: [id])

  estado String @default("abierto") // "abierto" | "cerrado"

  montoInicial Decimal  @db.Decimal(10, 2) @default(0)
  abiertoPor   String
  abiertoEn    DateTime @default(now())

  cantidadVentas          Int?
  calculadoEfectivo       Decimal? @db.Decimal(10, 2)
  calculadoTransferencia  Decimal? @db.Decimal(10, 2)
  calculadoTarjetaDebito  Decimal? @db.Decimal(10, 2)
  calculadoTarjetaCredito Decimal? @db.Decimal(10, 2)

  declaradoEfectivo       Decimal? @db.Decimal(10, 2)
  declaradoTransferencia  Decimal? @db.Decimal(10, 2)
  declaradoTarjetaDebito  Decimal? @db.Decimal(10, 2)
  declaradoTarjetaCredito Decimal? @db.Decimal(10, 2)

  notas      String?
  cerradoPor String?
  cerradoEn  DateTime?

  ventas  VentaPos[]
  // Pedidos de retiro/mesa cobrados en este turno (ver Order.turnoPosId) —
  // el mismo cierre que las ventas de mostrador, no uno aparte.
  pedidos Order[]
  // Rendiciones de repartidor recibidas mientras este turno estaba abierto
  // (ver Rendicion.turnoPosId) — el corte general del turno las suma aparte,
  // sin mezclar sus formas de cobro (efectivo/tarjeta/transferencia/ya
  // pagado) con las 4 de mostrador, que no son exactamente lo mismo.
  rendiciones Rendicion[]

  @@index([storeId])
  @@index([storeId, estado])
  @@index([estacionId])
}

/// Una notebook/caja física del local — la unidad de concurrencia del POS.
/// Vinculada a un navegador por cookie (ver src/lib/estacion-actual.ts), no
/// a un usuario: cualquier cajero que abra el panel desde esa computadora
/// opera bajo esta estación.
model Estacion {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  activa    Boolean    @default(true)
  createdAt DateTime   @default(now())
  turnos    TurnoPos[]

  // Sin punto asignado, esta estación solo puede vender como Ticket (no
  // Factura) — ver PuntoExpedicion.
  puntoExpedicionId String?
  puntoExpedicion   PuntoExpedicion? @relation(fields: [puntoExpedicionId], references: [id])

  // Qué Área de Impresión maneja el ticket/factura EN ESTA estación — la
  // impresora real se resuelve igual que cualquier otra área, vía
  // EstacionImpresora (estacionId, areaTicketId). Null = ticket sin
  // impresión automática, cae al fallback manual.
  areaTicketId String?
  areaTicket   AreaImpresion? @relation(fields: [areaTicketId], references: [id], onDelete: SetNull)
  // Mapeo de cada Área de Impresión a la impresora real que QZ Tray ve EN
  // ESTA notebook — una fila por área configurada (ver EstacionImpresora).
  impresoras   EstacionImpresora[]

  @@index([storeId])
}

/// Un "destino" de impresión configurable (Cocina, Barra, Caja...). Cada
/// Product se asocia a una (ver Product.areaImpresionId) y cada Estacion
/// mapea cada área a la impresora real que ve esa notebook (ver
/// EstacionImpresora) — el mapeo NO se comparte entre estaciones porque
/// Windows puede nombrar la misma impresora de red distinto en cada una.
model AreaImpresion {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  productos          Product[]
  impresorasEstacion EstacionImpresora[]
  estacionesTicket   Estacion[]

  @@index([storeId])
}

/// Para una Estacion puntual, qué impresora real (nombre EXACTO tal cual lo
/// reporta qz.printers.find() en esa notebook) maneja cada Área de
/// Impresión — no es un catálogo, es lo que esa máquina ve en ese momento.
model EstacionImpresora {
  id         String   @id @default(cuid())
  // Se repite el local acá (aunque se podría deducir de la estación) para
  // que el filtro automático funcione igual en todas las tablas — mismo
  // criterio que OrderItem/VentaPosItem.
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  estacionId String
  estacion   Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)
  areaImpresionId String
  areaImpresion   AreaImpresion @relation(fields: [areaImpresionId], references: [id], onDelete: Cascade)
  nombreImpresora String

  @@unique([estacionId, areaImpresionId])
  @@index([storeId])
  @@index([estacionId])
}

/// Un punto de expedición autorizado por la DNIT para Factura Autoimpresor.
/// Una o varias Estacion pueden usar el MISMO punto de expedición (comparten
/// numeración) o cada una el suyo (numeran por separado) — lo decide el
/// dueño asignándolo en /admin/pos/estaciones, no hay lógica especial acá.
model PuntoExpedicion {
  id              String     @id @default(cuid())
  storeId         String
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nombre          String // etiqueta interna, ej "Mostrador"
  establecimiento String // 3 dígitos, ej "001"
  puntoExpedicion String // 3 dígitos, ej "001"
  numeroTimbrado  String
  timbradoDesde   DateTime
  timbradoHasta   DateTime

  // La razón social/RUC del EMISOR (el negocio, a nombre de quién la DNIT
  // autorizó el timbrado) que va impresa en la factura — distinto de
  // Store.razonSocial/ruc, que son datos internos de TuMenuSmart para
  // facturarle al dueño y ni siquiera se le muestran a él en su panel.
  razonSocialEmisor String
  rucEmisor         String

  // Cuántas facturas ya salieron de este punto — mismo patrón que
  // Store.contadorVentasPos: arranca en 0, se incrementa ATÓMICAMENTE y el
  // valor YA incrementado es el número que le toca a esa factura (nunca se
  // lee primero y se incrementa después, porque entre esas dos operaciones
  // dos ventas en simultáneo podrían agarrar el mismo número).
  ultimoNumeroFactura Int @default(0)

  activo     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  estaciones Estacion[]

  @@index([storeId])
}

/// Una cuenta cobrada en el mostrador (venta rápida de POS).
model VentaPos {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  turnoPosId    String
  turnoPos      TurnoPos @relation(fields: [turnoPosId], references: [id])
  // Mismo criterio que Order.numero: sale de contadorVentasPos del local y
  // deliberadamente no tiene valor por defecto.
  numero        Int
  formaPago     String   // "efectivo" | "transferencia" | "tarjeta_debito" | "tarjeta_credito"
  total         Decimal  @db.Decimal(10, 2)
  registradoPor String
  creadoEn      DateTime @default(now())
  items         VentaPosItem[]

  // Opcionales: mucha venta de mostrador es un cliente de paso que no vale
  // la pena frenar para pedirle el teléfono. Cuando SÍ se carga, cuenta
  // para el mismo programa de fidelización que los pedidos online (ver
  // src/lib/fidelidad.ts) — mismo criterio de "guardado tal cual lo tipea"
  // que ya usa Order.clienteTelefono, para que las dos fuentes sumen al
  // mismo cliente sin tener que reformatear nada.
  clienteNombre   String?
  clienteTelefono String?
  // "local" (se consume ahí) | "llevar" (para llevar, necesita empaque).
  tipoEntrega     String  @default("local")
  nota            String?

  // Anular una cuenta ya cobrada (se cargó mal, el cliente se arrepintió,
  // etc.) sin borrar el registro — deja rastro de quién y por qué. Solo se
  // permite mientras el turno (turnoPos) sigue "abierto": una vez cerrado,
  // el cajero ya declaró esos montos en el corte ciego, así que
  // cancelarVenta (pos/actions.ts) rechaza la anulación en vez de dejar
  // tocar una cuenta que ya quedó firmada en un cierre.
  cancelada         Boolean   @default(false)
  canceladaPor      String?
  canceladaEn       DateTime?
  motivoCancelacion String?

  // Mismos campos informales que Order ya tiene: lo que pide el cliente
  // para que le facturen. "ticket" | "factura".
  comprobanteTipo    String  @default("ticket")
  facturaRazonSocial String? // null si facturaTipoIdentificacion es "sin_nombre" (Consumidor Final)
  // Número de identificación del comprador, sea cual sea el tipo (RUC,
  // Cédula, Pasaporte, "X" para Sin Nombre, etc. — ver facturaTipoIdentificacion
  // y src/lib/tipo-cliente.ts). El nombre del campo quedó de la Fase 3,
  // cuando solo existía RUC; el ticket usa etiquetaTipoIdentificacion() para
  // imprimir la etiqueta correcta en vez de "RUC" fijo.
  facturaRuc         String?
  // Clasificación fiscal SET del comprador (Tabla 3, RG 90/2021) — "ruc" |
  // "cedula" | "pasaporte" | "cedula_extranjera" | "diplomatico" |
  // "identificacion_tributaria" | "sin_nombre". Null en facturas viejas de
  // antes de la Fase 5, donde solo se guardaba RUC a secas.
  facturaTipoIdentificacion String?

  // Fiscales — se completan y se CONGELAN solo cuando comprobanteTipo pasa
  // a "factura" (ver registrarVenta en pos/actions.ts). Nunca se recalculan
  // después, mismo criterio que TurnoPos.calculado*/Rendicion.
  facturaNumero      String? // "001-001-0000001", ya formateado
  facturaTimbrado    String?
  facturaVencimiento DateTime?
  facturaGravado10   Decimal?  @db.Decimal(10, 2)
  facturaGravado5    Decimal?  @db.Decimal(10, 2)
  facturaExento      Decimal?  @db.Decimal(10, 2)
  facturaIva10       Decimal?  @db.Decimal(10, 2)
  facturaIva5        Decimal?  @db.Decimal(10, 2)

  // Anular SOLO la factura, sin cancelar la cuenta — mismo criterio que
  // Order.facturaAnulada (ver ese comentario). Cancelar la cuenta entera
  // SIGUE anulando la factura de yapa (ver cancelarVenta); esto agrega el
  // camino inverso: anular solo el número, cuenta viva.
  facturaAnulada         Boolean   @default(false)
  facturaAnuladaPor      String?
  facturaAnuladaEn       DateTime?
  facturaMotivoAnulacion String?

  @@index([storeId])
  @@index([turnoPosId])
  @@index([storeId, creadoEn])
}

model VentaPosItem {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ventaPosId     String
  ventaPos       VentaPos @relation(fields: [ventaPosId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  nombreProducto String   // snapshot: el nombre al momento de la venta
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  // Snapshot de la tasa de IVA al momento de la venta — igual que
  // nombreProducto/precioUnitario: si el producto cambia de tasa después,
  // las facturas viejas no se mueven solas.
  iva            String   @default("gravado10")
  // Snapshot de los agregados elegidos, en texto legible — igual que
  // OrderItem.opcionesTexto. Null si no se eligió ninguno.
  opcionesTexto  String?

  @@index([storeId])
  @@index([ventaPosId])
}
